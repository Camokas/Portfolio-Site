{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "81700125452b4eafb2c5959bb7cca0f6",
    "m_Group": {
        "m_Id": "3bd03fb3d78845f7b754101fe789253f"
    },
    "m_Name": "TiledHeart (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -993.0003051757813,
            "y": -3111.0,
            "width": 214.00018310546876,
            "height": 374.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "6fb5a4e34a494b528e845c64f1e45204"
        },
        {
            "m_Id": "3f3f6e53d9034b928d3edfd5083e934e"
        },
        {
            "m_Id": "8f2d1e04f91047c291cb9d7270b0c18e"
        },
        {
            "m_Id": "83b2ec7d764e4dbc8ea9ff68fb232b28"
        },
        {
            "m_Id": "e01612ef4cae4627a7c7e36ec6269edc"
        },
        {
            "m_Id": "ddd57213171342c889f94660c67df66e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TiledHeart",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 g = UV * Tiling;\nfloat2 cell = floor(g);\nfloat2 p = frac(g) * 2.0 - 1.0;\n\n// hash\nfloat rx = frac(sin(dot(cell, float2(127.1, 311.7))) * 43758.5453);\nfloat ry = frac(sin(dot(cell, float2(269.5, 183.3))) * 43758.5453);\nfloat rs = frac(sin(dot(cell, float2(419.2, 371.9))) * 43758.5453);\n\n// случайное смещение\nfloat2 offset = (float2(rx, ry) * 2.0 - 1.0) * OffsetAmount;\np -= offset;\n\n// случайный размер\nfloat s = 1.0 + (rs * 2.0 - 1.0) * ScaleAmount;\np /= s;\n\n// общий размер\np /= HeartSize;\n\n// форма сердца\np *= 1.25;\np.y *= 1.1;\n\nfloat x2 = p.x * p.x;\nfloat y2 = p.y * p.y;\nfloat y3 = y2 * p.y;\nfloat a = x2 + y2 - 1.0;\nfloat h = a * a * a - x2 * y3;\n\nMask = 1.0 - smoothstep(0.0, 0.03, h);"
}

