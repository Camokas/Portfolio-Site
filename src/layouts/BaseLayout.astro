---
import "../styles/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import PageMetadata from "../components/layout/PageMetadata.astro";

interface Props {
	title: string;
	description: string;
	lang?: string;
	type?: "website" | "article";
	publishedAt?: Date;
	noindex?: boolean;
}

const { title, description, lang = "en", type, publishedAt, noindex } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} data-language={lang}>
	<head>
		<script is:inline>
			try {
				const savedLanguage = localStorage.getItem("portfolio-language");
				if (savedLanguage === "ru" || savedLanguage === "en") {
					document.documentElement.lang = savedLanguage;
					document.documentElement.dataset.language = savedLanguage;
				}
			} catch { /* English remains the safe default. */ }
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<PageMetadata title={title} description={description} lang={lang} type={type} publishedAt={publishedAt} noindex={noindex} />

		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />

		<title>{title}</title>
	</head>

	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<script src="../scripts/language.ts"></script>
	</body>
</html>
