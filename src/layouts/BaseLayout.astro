---
import "../styles/global.css";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import PageMetadata from "../components/layout/PageMetadata.astro";

interface Props {
	title: string;
	description: string;
	lang?: string;
	type?: "website" | "article";
	publishedAt?: Date;
	noindex?: boolean;
}

const { title, description, lang = "en", type, publishedAt, noindex } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
import { localizedMedia } from "../data/localizedMedia";
const mediaVersions = localizedMedia();
---

<!doctype html>
<html lang={lang} data-language={lang}>
	<head>
		<script is:inline>
			let savedLanguage;
			try { savedLanguage = localStorage.getItem("portfolio-language"); } catch {}
			const preferred = (navigator.languages || [navigator.language])
				.map(value => value.toLowerCase().split("-")[0])
				.find(value => value === "en" || value === "ru") || "en";
			const language = savedLanguage === "ru" || savedLanguage === "en" ? savedLanguage : preferred;
			document.documentElement.lang = language;
			document.documentElement.dataset.language = language;
			try { localStorage.setItem("portfolio-language", language); } catch {}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<PageMetadata title={title} description={description} lang={lang} type={type} publishedAt={publishedAt} noindex={noindex} />

		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />

		<title>{title}</title>
	</head>

	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<div hidden id="localized-media" data-versions={JSON.stringify(mediaVersions)}></div>
		<script src="../scripts/language.ts"></script>
	</body>
</html>
