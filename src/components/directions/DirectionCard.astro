---
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../data/icons";

interface Props {
	numberLabel: string;
	title: string;
	description: string;
	slug: string;
	icon: IconName;
}

const { numberLabel, title, description, slug, icon } = Astro.props;

const href = `${import.meta.env.BASE_URL}directions/${slug}/`;
---

<li class="direction-item">
	<a class="direction-card" href={href}>
		<div class="direction-marker" aria-hidden="true">
			<span class="direction-icon"><Icon name={icon} size={22} /></span>
			<span class="direction-number">{numberLabel}</span>
		</div>

		<h3>{title}</h3>

		<p>{description}</p>
	</a>
</li>

<style>
	.direction-item {
		min-width: 0;
	}

	.direction-card {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 1.25rem;
		height: 100%;
		min-height: 15rem;
		padding: 1.5rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.direction-card:hover {
		transform: translateY(-0.25rem);
		border-color: var(--color-accent);
	}

	.direction-card:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.direction-number {
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.direction-marker {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.direction-icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		aspect-ratio: 1;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition:
			color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease;
	}

	.direction-card:hover .direction-icon {
		color: var(--color-background);
		border-color: var(--color-accent);
		background: var(--color-accent);
		transform: rotate(-5deg);
	}

	h3 {
		align-self: end;
		margin: 0;
		font-size: 1.5rem;
		line-height: 1.15;
	}

	p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.6;
	}
</style>
