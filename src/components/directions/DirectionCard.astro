---
interface Props {
	numberLabel: string;
	title: string;
	description: string;
	slug: string;
}

const { numberLabel, title, description, slug } = Astro.props;

const href = `${import.meta.env.BASE_URL}directions/${slug}/`;
---

<li class="direction-item">
	<a class="direction-card" href={href}>
		<span class="direction-number" aria-hidden="true">
			{numberLabel}
		</span>

		<h3>{title}</h3>

		<p>{description}</p>
	</a>
</li>

<style>
	.direction-item {
		min-width: 0;
	}

	.direction-card {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 1.25rem;
		height: 100%;
		min-height: 15rem;
		padding: 1.5rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.direction-card:hover {
		transform: translateY(-0.25rem);
		border-color: var(--color-accent);
	}

	.direction-card:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.direction-number {
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h3 {
		align-self: end;
		margin: 0;
		font-size: 1.5rem;
		line-height: 1.15;
	}

	p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.6;
	}
</style>