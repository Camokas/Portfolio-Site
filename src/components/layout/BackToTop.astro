---
import Icon from "../ui/Icon.astro";
---
<button class="back-to-top" type="button" aria-label="Back to top" title="Back to top"
	aria-hidden="true" tabindex="-1" data-visible="false">
	<Icon name="arrow-left" size={18} />
	<span>Back to top</span>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>(".back-to-top");
	if (button) {
		const preference = matchMedia("(prefers-reduced-motion: reduce)");
		let frame = 0;
		const update = () => {
			frame = 0;
			const visible = scrollY > Math.max(480, innerHeight * .85);
			button.dataset.visible = String(visible);
			button.setAttribute("aria-hidden", String(!visible));
			button.tabIndex = visible ? 0 : -1;
		};
		const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
		addEventListener("scroll", schedule, {passive:true});
		addEventListener("resize", schedule, {passive:true});
		button.addEventListener("click", () => {
			document.getElementById("main-content")?.focus({preventScroll:true});
			window.scrollTo({top:0, behavior:preference.matches ? "instant" : "smooth"});
		});
		update();
	}
</script>
<style>
.back-to-top {
	position:fixed;right:max(1.25rem,env(safe-area-inset-right));bottom:calc(1.25rem + env(safe-area-inset-bottom));
	z-index:40;display:inline-flex;align-items:center;gap:.55rem;padding:.8rem 1rem;
	border:1px solid var(--color-border);border-radius:999px;background:rgb(22 22 22 / .93);
	color:var(--color-text);box-shadow:0 6px 24px rgb(0 0 0 / .22);cursor:pointer;
	font:inherit;font-size:.8rem;font-weight:600;opacity:0;visibility:hidden;pointer-events:none;
	transform:translateY(8px);transition:opacity 220ms ease,transform 220ms ease,visibility 220ms,border-color 180ms ease;
}
.back-to-top[data-visible="true"]{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0)}
.back-to-top :global(svg){transform:rotate(90deg)}
.back-to-top:hover{border-color:var(--color-accent)}
.back-to-top:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
@media(max-width:32rem){.back-to-top{padding:.85rem}.back-to-top span{display:none}}
@media print{.back-to-top{display:none}}
@media(prefers-reduced-motion:reduce){.back-to-top{transition:none;transform:none}}
</style>
