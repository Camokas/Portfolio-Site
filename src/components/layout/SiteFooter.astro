---
import Icon from "../ui/Icon.astro";
import { getBuildCommit } from "../../data/latestCommit";

const currentYear = new Date().getFullYear();
const homeUrl = import.meta.env.BASE_URL;
const contactUrl = `${homeUrl}#contact`;
const repositoryUrl = "https://github.com/Camokas/Portfolio-Site";
const commitsApiUrl =
	"https://api.github.com/repos/Camokas/Portfolio-Site/commits?sha=master&per_page=1";
const buildCommit = getBuildCommit(repositoryUrl);
const formattedCommitDate = buildCommit
	? new Intl.DateTimeFormat("en", {
			dateStyle: "medium",
			timeStyle: "short",
		}).format(new Date(buildCommit.date))
	: "View repository";
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-copy">
			<p>© {currentYear} Camoka</p>

			<p class="last-updated" aria-live="polite">
				<Icon name="clock-3" size={15} />
				<span>Last website update:</span>

				<a
					href={buildCommit?.url ?? repositoryUrl}
					target="_blank"
					rel="noreferrer"
					data-latest-commit
					data-api-url={commitsApiUrl}
					data-repository-url={repositoryUrl}
				>
					<time datetime={buildCommit?.date} data-latest-commit-date data-date-format="commit">
						{formattedCommitDate}
					</time>
				</a>
			</p>
		</div>

		<nav aria-label="Footer navigation">
			<a href={contactUrl}><Icon name="mail" size={16} />Contact</a>
			<a href={homeUrl}><Icon name="house" size={16} />Back to home</a>
		</nav>
	</div>
</footer>

<script src="../../scripts/latestCommit.ts"></script>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 2rem), var(--content-width));
		min-height: 7rem;
		margin-inline: auto;
		gap: 1.5rem;
	}

	.footer-copy {
		display: grid;
		gap: 0.5rem;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	p {
		margin: 0;
		color: var(--color-muted);
	}

	.last-updated {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.35rem;
		font-size: 0.85rem;
	}

	a {
		color: var(--color-text);
		font-weight: 650;
		text-decoration: none;
	}

	nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	a:hover {
		color: var(--color-accent);
	}

	.last-updated a {
		color: var(--color-muted);
		font-weight: inherit;
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 0.2em;
	}

	.last-updated a:hover {
		color: var(--color-accent);
		text-decoration-color: currentColor;
	}

	a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.3rem;
		border-radius: 0.15rem;
	}

	@media (max-width: 32rem) {
		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
			justify-content: center;
		}

		nav {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
