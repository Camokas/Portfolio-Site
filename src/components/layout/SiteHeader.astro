---
import Icon from "../ui/Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const baseUrl = import.meta.env.BASE_URL;
const directionsUrl = `${baseUrl}#directions`;
const projectsUrl = `${baseUrl}projects/`;
const isHomePage = Astro.url.pathname === baseUrl;
const isDirectionPage = Astro.url.pathname.startsWith(`${baseUrl}directions/`);
const isProjectsPage = Astro.url.pathname.startsWith(projectsUrl);
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={baseUrl} aria-label="Camoka — home">
			Camoka<span aria-hidden="true">.</span>
		</a>

		<div class="header-actions">
		<nav aria-label="Primary navigation">
			<a
				class="nav-link"
				href={baseUrl}
				aria-label="Home"
				aria-current={isHomePage ? "page" : undefined}
			>
				<Icon name="house" size={16} />
				Home
			</a>

			<a
				class="nav-link"
				href={directionsUrl}
				aria-label="Directions"
				aria-current={isDirectionPage ? "page" : undefined}
			>
				<Icon name="compass" size={16} />
				Directions
			</a>

			<a
				class="nav-link"
				href={projectsUrl}
				aria-label="Projects"
				aria-current={isProjectsPage ? "page" : undefined}
			>
				<Icon name="layout-grid" size={16} />
				Projects
			</a>
		</nav>
		<LanguageSwitcher />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
		background: color-mix(in srgb, var(--color-background) 88%, transparent);
		backdrop-filter: blur(1rem);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 2rem), var(--content-width));
		min-height: 4.5rem;
		margin-inline: auto;
		gap: 1rem;
	}

	.brand {
		color: var(--color-text);
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		text-decoration: none;
	}

	.brand span {
		color: var(--color-accent);
	}

	nav {
		display: flex;
		align-items: center;
		gap: clamp(0.65rem, 3vw, 1.5rem);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 2.5vw, 1.5rem);
	}

	.nav-link {
		min-height: 2.75rem;
		min-width: 2.75rem;
		justify-content: center;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--color-muted);
		font-size: clamp(0.78rem, 2.5vw, 0.9rem);
		font-weight: 650;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.nav-link:hover,
	.nav-link[aria-current="page"] {
		color: var(--color-text);
	}

	.brand:focus-visible,
	.nav-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.3rem;
		border-radius: 0.15rem;
	}

	@media (max-width: 32rem) {
		.header-inner {
			gap: 0.65rem;
		}

		.header-actions,
		nav {
			gap: 0.35rem;
		}
		.nav-link {
			gap: 0;
			font-size: 0;
		}

		.nav-link :global(svg) {
			width: 1.15rem;
			height: 1.15rem;
		}
	}
</style>
