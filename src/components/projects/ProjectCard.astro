---
import MediaPreview from "./MediaPreview.astro";
import ProjectDate from "./ProjectDate.astro";
import { projectPreviews } from "../../data/projectPreviews";
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { translateExact } from "../../data/translations";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const previews = await projectPreviews(project);
const projectUrl = `${import.meta.env.BASE_URL}projects/${project.id}/`;
const englishSearch = `${project.data.title} ${project.data.summary} ${project.data.tags.join(" ")}`;
const russianSearch = [project.data.title, project.data.summary, ...project.data.tags]
	.map((value) => translateExact(value.trim(), "ru"))
	.join(" ");
---

<li class="project-item"
	data-project-card
	data-title={project.data.title}
	data-search={`${englishSearch} ${russianSearch}`}
	data-direction={project.data.direction}
	data-date={project.data.date.getTime()}
>
	<article class="project-card">
		{previews.length > 0 && <MediaPreview items={previews} />}
		<a href={projectUrl} aria-label={`Open ${project.data.title}`}>

			<div class="project-content">
				<div class="project-meta">
					<ProjectDate date={project.data.date} dateEnd={project.data.dateEnd} short />

					{project.data.demo && <span>Demo</span>}
				</div>

				<h3>{project.data.title}</h3>

				{project.data.summary && <project-summary class="summary-reveal"><p><span>{project.data.summary}</span></p></project-summary>}

				<span class="project-action" aria-hidden="true">
					View project <Icon name="arrow-right" size={17} />
				</span>
			</div>
		</a>
	</article>
</li>

<script>
	class ProjectSummary extends HTMLElement {
		events?: AbortController;
		animation?: Animation;
		shown = false;
		connectedCallback() {
			const card = this.closest(".project-card");
			if (!card) return;
			this.events?.abort(); this.events = new AbortController();
			const options = { signal: this.events.signal };
			const touch = matchMedia("(hover: none)");
			const update = () => this.reveal(touch.matches || card.matches(":hover") || card.contains(document.activeElement));
			card.addEventListener("mouseenter", update, options);
			card.addEventListener("mouseleave", update, options);
			card.addEventListener("focusin", update, options);
			card.addEventListener("focusout", () => queueMicrotask(() => { if (this.isConnected) update(); }), options);
			touch.addEventListener("change", update, options);
			update();
		}
		reveal(show: boolean) {
			if (show === this.shown) return;
			this.shown = show;
			const current = getComputedStyle(this);
			const from = { height: current.height, opacity: current.opacity, transform: current.transform };
			this.animation?.cancel();
			const height = show ? `${this.querySelector("p")!.getBoundingClientRect().height}px` : "0px";
			const to = { height, opacity: show ? "1" : "0", transform: show ? "translateY(0)" : "translateY(0.5rem)" };
			const animation = this.animate([from, to], { duration: 450, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "forwards" });
			this.animation = animation;
			animation.onfinish = () => {
				if (this.animation !== animation) return;
				this.style.height = show ? "auto" : "0px";
				this.style.opacity = to.opacity;
				this.style.transform = to.transform;
				animation.cancel(); this.animation = undefined;
			};
		}
		disconnectedCallback() { this.events?.abort(); this.animation?.cancel(); }
	}
	if (!customElements.get("project-summary")) customElements.define("project-summary", ProjectSummary);
</script>

<style>
	.project-item {
		min-width: 0;
	}

	.project-card {
		position: relative;
		display: grid;
		min-height: 20rem;
		height: 100%;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}
	.project-card > a { position: relative; z-index: 1; display: flex; color: inherit; text-decoration: none; background: linear-gradient(rgb(14 14 14 / 0.55), rgb(14 14 14 / 0.95)); }
	.project-card > a.project-preview { display: grid; }
	.project-content { width: 100%; }

	.project-card:hover {
		transform: translateY(-0.25rem);
		border-color: var(--color-accent);
	}

	.project-card > a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: -3px;
	}

	.project-preview {
		display: grid;
		place-items: center;
		overflow: hidden;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		background:
			linear-gradient(135deg, transparent 35%, rgb(255 192 167 / 0.12)),
			#211914;
		border-bottom: 1px solid var(--color-border);
	}

	.project-content {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
	}

	.project-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h3 {
		margin: 1.25rem 0 0;
		font-size: 1.5rem;
		line-height: 1.15;
	}

	p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.6;
	}
	.summary-reveal { display: block; height: 0; overflow: hidden; opacity: 0; transform: translateY(0.5rem); }
	.summary-reveal p { min-height: 0; overflow: hidden; }
	.summary-reveal span { display: -webkit-box; padding-top: 0.75rem; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
	.project-card:hover project-summary:not(:defined), .project-card:focus-within project-summary:not(:defined) { height: auto; opacity: 1; transform: none; }
	@media (hover: none) { project-summary:not(:defined) { height: auto; opacity: 1; transform: none; } }

	.project-action {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		padding-top: 1.5rem;
		color: var(--color-accent);
		font-size: 0.9rem;
		font-weight: 700;
	}

	.project-action :global(svg) {
		transition: transform 180ms ease;
	}

	.project-card > a:hover .project-action :global(svg) {
		transform: translateX(0.2rem);
	}
</style>
