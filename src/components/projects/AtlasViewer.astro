---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { projectAssetUrl } from "../../data/projectAssetPaths.mjs";
interface Props { items: {title: string; image: string; manifest: string}[]; }
const { items } = Astro.props;
const atlases = items.map(item => {
	const data = JSON.parse(readFileSync(resolve("public", item.manifest), "utf8"));
	if (!data.sprites?.length || !data.width || !data.height) throw new Error(`Invalid atlas manifest: ${item.manifest}`);
	return {...item, count: data.sprites.length};
});
const url = (path: string) => projectAssetUrl(path, import.meta.env.BASE_URL);
---

<atlas-viewer class="atlas-viewer">
	<div class="atlas-toolbar">
		<label class="atlas-choice"><span>Atlas</span><select data-atlas aria-label="Choose an atlas">{atlases.map(item => <option value={url(item.image)} data-manifest={url(item.manifest)}>{item.title}</option>)}</select></label>
		<div class="zoom-controls">
			<button type="button" data-out aria-label="Zoom out">−</button>
			<output data-zoom aria-label="Zoom level" data-i18n-ignore>100%</output>
			<button type="button" data-in aria-label="Zoom in">+</button>
			<button type="button" data-fit>Fit artwork</button>
			<button type="button" data-actual>1:1</button>
		</div>
		<label class="boundaries"><input type="checkbox" data-bounds /><span>Sprite boundaries</span></label>
	</div>
	<p class="viewer-help">Drag to pan. Use the zoom buttons, Ctrl + wheel, or pinch with two fingers. Select a sprite to inspect its pixels.</p>
	<div class="atlas-workspace">
		<div class="atlas-stage">
			<img class="atlas-fallback" src={url(items[0].image)} alt="Texture atlas artwork" decoding="async" />
			<canvas class="atlas-canvas" role="img" aria-label="Texture atlas with pixel rulers" hidden></canvas>
		</div>
		<aside class="sprite-inspector" aria-label="Sprite inspector">
			<p class="atlas-stats" data-stats data-i18n-ignore></p>
			<label><span>Find a sprite</span><input type="search" data-search placeholder="Search sprite names" /></label>
			<select class="sprite-list" data-sprites size="6" aria-label="Choose a sprite" data-i18n-ignore></select>
			<p data-empty hidden>No matching sprites.</p>
			<div class="sprite-preview"><canvas data-preview role="img" aria-label="Selected sprite enlarged without smoothing"></canvas></div>
			<p class="sprite-name" data-name data-i18n-ignore></p>
			<p class="sprite-details" data-details data-i18n-ignore></p>
			<div class="sprite-navigation"><button type="button" data-prev>Previous sprite</button><button type="button" data-next>Next sprite</button></div>
			<button type="button" data-focus>Centre selected sprite</button>
		</aside>
	</div>
	<p class="atlas-error" role="status" hidden>The atlas could not be loaded. Reload the page to try again.</p>
	<noscript><p>The complete atlas is shown above. Enable JavaScript to zoom and browse individual sprites.</p></noscript>
</atlas-viewer>

<script>
	import { spriteAt } from "../../data/atlasGeometry.mjs";
	type Rect = {x:number; y:number; width:number; height:number};
	type Sprite = Rect & {name:string};
	type Atlas = {width:number; height:number; bounds:Rect; sprites:Sprite[]};
	class AtlasViewerElement extends HTMLElement {
		events?: AbortController;
		stop?: () => void;
		connectedCallback() {
			this.stop?.();
			const events = this.events = new AbortController(), on = {signal:events.signal};
			const q = <T extends Element = HTMLElement>(selector:string) => this.querySelector<T>(selector)!;
			const canvas = q<HTMLCanvasElement>(".atlas-canvas"), preview = q<HTMLCanvasElement>("[data-preview]");
			const ctx = canvas.getContext("2d"), pctx = preview.getContext("2d");
			if (!ctx || !pctx) return;
			const stage = q(".atlas-stage"), image = q<HTMLImageElement>(".atlas-fallback");
			const atlasSelect = q<HTMLSelectElement>("[data-atlas]"), list = q<HTMLSelectElement>("[data-sprites]");
			const search = q<HTMLInputElement>("[data-search]"), bounds = q<HTMLInputElement>("[data-bounds]");
			let atlas:Atlas | undefined, selected = 0, scale = 1, panX = 24, panY = 24, w = 0, h = 0, frame = 0;
			let request:AbortController | undefined, generation = 0;
			let framed:Rect | undefined;
			const ruler = 24, pointers = new Map<number,{x:number;y:number}>();
			const render = () => {
				frame = 0;
				if (!atlas || !image.complete) return;
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				w = stage.clientWidth; h = stage.clientHeight;
				canvas.width = Math.round(w*dpr); canvas.height = Math.round(h*dpr);
				ctx.setTransform(dpr,0,0,dpr,0,0); ctx.imageSmoothingEnabled = false;
				ctx.clearRect(0,0,w,h); ctx.save(); ctx.beginPath(); ctx.rect(ruler,ruler,w-ruler,h-ruler); ctx.clip();
				ctx.drawImage(image, Math.round(panX), Math.round(panY), atlas.width*scale, atlas.height*scale);
				if (bounds.checked) {
					ctx.strokeStyle = '#ffffff50'; ctx.lineWidth = 1;
					for (const s of atlas.sprites) {
						const x = panX+s.x*scale, y = panY+s.y*scale;
						if (x > w || y > h || x+s.width*scale < ruler || y+s.height*scale < ruler) continue;
						ctx.strokeRect(Math.round(x)+.5,Math.round(y)+.5,s.width*scale,s.height*scale);
					}
				}
				const s = atlas.sprites[selected];
				if (s) { ctx.strokeStyle='#f0cf89'; ctx.lineWidth=2; ctx.strokeRect(Math.round(panX+s.x*scale),Math.round(panY+s.y*scale),s.width*scale,s.height*scale); }
				ctx.restore();
				ctx.fillStyle='#202020'; ctx.fillRect(0,0,w,ruler); ctx.fillRect(0,0,ruler,h);
				ctx.fillStyle='#c5c5c5'; ctx.strokeStyle='#666'; ctx.font='10px ui-monospace,monospace';
				let step=1; while(step*scale<55) step*=2;
				for(let x=Math.max(0,Math.ceil((ruler-panX)/scale/step)*step); x<=atlas.width && panX+x*scale<w; x+=step){const px=Math.round(panX+x*scale);ctx.fillText(String(x),px+3,13);ctx.fillRect(px,19,1,5);}
				for(let y=Math.max(0,Math.ceil((ruler-panY)/scale/step)*step); y<=atlas.height && panY+y*scale<h; y+=step){const py=Math.round(panY+y*scale);ctx.save();ctx.translate(12,py+3);ctx.rotate(-Math.PI/2);ctx.fillText(String(y),0,0);ctx.restore();ctx.fillRect(19,py,5,1);}
				q("[data-zoom]").textContent=`${Math.round(scale*100)}%`;
			};
			const draw = () => { if (!frame) frame=requestAnimationFrame(render); };
			const clampPan = () => {
				if (!atlas) return;
				panX=Math.max(ruler-atlas.width*scale+32,Math.min(w-32,panX));
				panY=Math.max(ruler-atlas.height*scale+32,Math.min(h-32,panY));
			};
			const zoom = (value:number,x=w/2,y=h/2) => {
				framed=undefined;
				const next=Math.max(1/32,Math.min(64,value));
				panX=x-(x-panX)*next/scale; panY=y-(y-panY)*next/scale; scale=next; clampPan(); draw();
			};
			const fit = (rect:Rect) => {
				framed=rect;
				w=stage.clientWidth; h=stage.clientHeight;
				const wanted=Math.min((w-ruler-48)/rect.width,(h-ruler-48)/rect.height,32);
				scale=Math.max(1/32,wanted>=1?Math.floor(wanted):wanted);
				panX=ruler+(w-ruler-rect.width*scale)/2-rect.x*scale; panY=ruler+(h-ruler-rect.height*scale)/2-rect.y*scale; draw();
			};
			const updatePreview = () => {
				if (!atlas) return;
				const s=atlas.sprites[selected]; if(!s) return;
				q("[data-name]").textContent=s.name;
				q("[data-details]").textContent=`${s.width} × ${s.height} px · X ${s.x} · Y ${s.y}`;
				// The backing image is drawn at an integer multiple of its original pixels.
				const ratio=Math.max(1,Math.floor(Math.min(208/s.width,176/s.height)));
				preview.width=s.width*ratio; preview.height=s.height*ratio;
				pctx.imageSmoothingEnabled=false; pctx.clearRect(0,0,preview.width,preview.height);
				pctx.drawImage(image,s.x,s.y,s.width,s.height,0,0,preview.width,preview.height);
				list.value=String(selected); draw();
			};
			const filter = () => {
				const fragment=document.createDocumentFragment(), term=search.value.trim().toLowerCase();
				atlas?.sprites.forEach((s,i)=>{if(s.name.toLowerCase().includes(term)){const option=new Option(s.name,String(i));fragment.append(option);}});
				list.replaceChildren(fragment); list.value=String(selected); q("[data-empty]").hidden=list.options.length>0;
			};
			const load = async () => {
				const id=++generation; request?.abort(); request=new AbortController();
				q(".atlas-error").hidden=true; this.setAttribute("aria-busy","true");
				try {
					atlas=undefined; canvas.hidden=true;
					const option=atlasSelect.selectedOptions[0];
					const response=await fetch(option.dataset.manifest!,{signal:request.signal}); if(!response.ok) throw new Error('Missing atlas');
					const data:Atlas=await response.json();
					image.src=option.value; await image.decode();
					if(id!==generation || !this.isConnected) return;
					if(data.width!==image.naturalWidth || data.height!==image.naturalHeight || !data.sprites?.length) throw new Error('Atlas dimensions differ');
					atlas=data; selected=0; search.value=''; filter();
					q("[data-stats]").textContent=`${data.width} × ${data.height} px · ${data.sprites.length}`;
					canvas.hidden=false; image.hidden=true; updatePreview(); fit(data.bounds ?? {x:0,y:0,width:data.width,height:data.height});
				} catch (error) { if(id===generation && !events.signal.aborted) { q(".atlas-error").hidden=false; canvas.hidden=true; image.hidden=false; } }
				finally { if(id===generation) this.removeAttribute("aria-busy"); }
			};
			atlasSelect.addEventListener('change',load,on);
			search.addEventListener('input',filter,on);
			list.addEventListener('change',()=>{selected=Number(list.value);updatePreview();if(atlas)fit(atlas.sprites[selected]);},on);
			bounds.addEventListener('change',draw,on);
			q('[data-fit]').addEventListener('click',()=>{if(atlas)fit(atlas.bounds);},on);
			q('[data-focus]').addEventListener('click',()=>{if(atlas)fit(atlas.sprites[selected]);},on);
			q('[data-actual]').addEventListener('click',()=>zoom(1),on);
			q('[data-in]').addEventListener('click',()=>zoom(scale<1?Math.min(1,scale*2):Math.ceil(scale*2)),on);
			q('[data-out]').addEventListener('click',()=>zoom(scale>1?Math.max(1,Math.floor(scale/2)):scale/2),on);
			const move=(direction:number)=>{const indices=[...list.options].map(o=>Number(o.value));if(!indices.length)return;const at=indices.indexOf(selected);selected=indices[(at+direction+indices.length)%indices.length];updatePreview();if(atlas)fit(atlas.sprites[selected]);};
			q('[data-prev]').addEventListener('click',()=>move(-1),on); q('[data-next]').addEventListener('click',()=>move(1),on);
			canvas.addEventListener('wheel',event=>{if(!event.ctrlKey)return;event.preventDefault();const r=canvas.getBoundingClientRect();zoom(scale*Math.exp(-event.deltaY*.005),event.clientX-r.left,event.clientY-r.top);},{...on,passive:false});
			let down:{x:number;y:number}|undefined, dragged=false;
			canvas.addEventListener('pointerdown',e=>{canvas.setPointerCapture(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});down={x:e.clientX,y:e.clientY};dragged=pointers.size>1;},on);
			canvas.addEventListener('pointermove',e=>{
				const old=pointers.get(e.pointerId);if(!old)return;
				const other=[...pointers.entries()].find(([id])=>id!==e.pointerId)?.[1];
				if(other){const before=Math.hypot(old.x-other.x,old.y-other.y),after=Math.hypot(e.clientX-other.x,e.clientY-other.y),r=canvas.getBoundingClientRect();if(before>1)zoom(scale*after/before,(e.clientX+other.x)/2-r.left,(e.clientY+other.y)/2-r.top);}
				else {framed=undefined;panX+=e.clientX-old.x;panY+=e.clientY-old.y;clampPan();draw();}
				if(down && Math.hypot(e.clientX-down.x,e.clientY-down.y)>4)dragged=true;
				pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
			},on);
			canvas.addEventListener('pointerup',e=>{
				if(!dragged && atlas){const r=canvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;const at=x>=ruler&&y>=ruler?spriteAt(atlas.sprites,(x-panX)/scale,(y-panY)/scale):-1;if(at>=0){selected=at;search.value='';filter();updatePreview();}}
				pointers.delete(e.pointerId);if(!pointers.size){if(scale>=1)zoom(Math.round(scale));down=undefined;}
			},on);
			canvas.addEventListener('pointercancel',e=>{pointers.delete(e.pointerId);down=undefined;},on);
			const observer=new ResizeObserver(()=>{if(atlas){if(framed)fit(framed);else draw();}});observer.observe(stage);
			this.stop=()=>{events.abort();request?.abort();observer.disconnect();cancelAnimationFrame(frame);};
			void load();
		}
		disconnectedCallback(){this.stop?.();}
	}
	if(!customElements.get('atlas-viewer'))customElements.define('atlas-viewer',AtlasViewerElement);
</script>

<style>
	.atlas-viewer { display:block; margin-block:2rem 3rem; padding:clamp(.75rem,2vw,1.25rem); border:1px solid var(--color-border); border-radius:1rem; background:var(--color-surface); }
	[hidden] { display:none !important; }
	.atlas-toolbar,.zoom-controls { display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; }
	.atlas-toolbar { justify-content:space-between; gap:1rem; }
	label { display:grid; gap:.35rem; color:var(--color-muted); font-size:.8rem; }
	.atlas-choice { display:flex; align-items:center; gap:.6rem; }
	button,select,input { font:inherit; color:var(--color-text); background:var(--color-background); border:1px solid var(--color-border); border-radius:.45rem; min-width:0; }
	button { padding:.5rem .65rem; cursor:pointer; font-size:.75rem; }
	button:hover { border-color:var(--color-accent); }
	select,input[type=search] { padding:.6rem; }
	.zoom-controls output { min-width:3rem; text-align:center; font-size:.75rem; font-variant-numeric:tabular-nums; }
	.boundaries { display:flex; align-items:center; gap:.4rem; }
	.boundaries input { accent-color:var(--color-accent); }
	.viewer-help,.atlas-error { color:var(--color-muted); font-size:.8rem; line-height:1.6; margin:.8rem 0 1rem; }
	.atlas-workspace { display:grid; grid-template-columns:minmax(0,1fr) 15rem; gap:1rem; }
	.atlas-stage { min-width:0; height:clamp(25rem,65vh,42rem); overflow:hidden; position:relative; border-radius:.5rem; background-color:#181818; background-image:linear-gradient(45deg,#222 25%,transparent 25%),linear-gradient(-45deg,#222 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#222 75%),linear-gradient(-45deg,transparent 75%,#222 75%); background-size:16px 16px; background-position:0 0,0 8px,8px -8px,-8px 0; }
	.atlas-canvas { display:block; width:100%; height:100%; touch-action:none; cursor:grab; }
	.atlas-canvas:active { cursor:grabbing; }
	.atlas-fallback { width:100%; height:100%; object-fit:contain; image-rendering:pixelated; }
	.sprite-inspector { min-width:0; display:flex; flex-direction:column; gap:.65rem; }
	.atlas-stats,.sprite-details { margin:0; color:var(--color-muted); font-size:.75rem; font-variant-numeric:tabular-nums; }
	.sprite-list { width:100%; min-height:9rem; font-size:.75rem; }
	.sprite-list option { padding:.25rem; }
	.sprite-preview { display:grid; place-items:center; min-height:8rem; overflow:auto; background:#202020; border-radius:.5rem; }
	.sprite-preview canvas { image-rendering:pixelated; max-width:100%; height:auto; }
	.sprite-name { margin:0; font-size:.85rem; overflow-wrap:anywhere; }
	.sprite-navigation { display:flex; flex-wrap:wrap; gap:.4rem; }
	:where(button,select,input):focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
	@media(max-width:48rem){.atlas-workspace{grid-template-columns:1fr;}.atlas-stage{height:25rem;}.sprite-inspector{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:start;}.atlas-stats,.sprite-inspector>label,.sprite-inspector>[data-empty]{grid-column:1/-1;}.sprite-preview{min-height:10rem;}.sprite-name,.sprite-details,.sprite-navigation,.sprite-inspector>[data-focus]{grid-column:1/-1;}.atlas-choice{width:100%;}.atlas-choice select{flex:1;}}
</style>
