---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ProjectDate from "./ProjectDate.astro";
interface Props { projects: CollectionEntry<"projects">[]; }
const { projects } = Astro.props;
const ordered = [...projects].sort((a,b) => b.data.date.getTime()-a.data.date.getTime() || a.id.localeCompare(b.id));
const month = (date: Date) => Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1);
const points = new Set(ordered.flatMap(({data}) => [month(data.date), ...(data.dateEnd ? [month(data.dateEnd)] : [])]));
if (points.size) {
	const low = new Date(Math.min(...points)).getUTCFullYear();
	const high = new Date(Math.max(...points)).getUTCFullYear();
	for (let year=low+1; year<=high; year++) points.add(Date.UTC(year,0,1));
}
const dates = [...points].sort((a,b) => b-a);
const row = (date: Date) => dates.indexOf(month(date))*2+1;
const formatter = new Intl.DateTimeFormat("en", {month:"long", year:"numeric", timeZone:"UTC"});
const periods = ordered.map((project,index) => ({project,index, side:index%2, start:row(project.data.date), end:row(project.data.dateEnd ?? project.data.date)}))
	.filter(item => item.end < item.start);
const occupied: {side:number; lane:number; start:number; end:number}[] = [];
const rails = periods.map(item => {
	let lane=0;
	while(occupied.some(other => other.side===item.side && other.lane===lane && item.end<=other.start && item.start>=other.end)) lane++;
	occupied.push({...item,lane});
	return {...item,lane};
});
---
<div class="project-timeline">
	<p class="timeline-intro">Projects ordered by start date · periods share the same calendar</p>
	<p class="timeline-note">Spacing adapts to the cards; distances are not a time scale.</p>
	<div class="timeline-grid">
		{rails.map(({side,lane,start,end,index}) => <div class:list={["period-rail",{"on-left":side===1}]} aria-hidden="true"
			style={`grid-row: ${end} / ${start}; --lane: ${lane}; --mobile-lane: ${index}`}><i></i><i></i></div>)}
		{dates.map((value,index) => {
			const date=new Date(value), year=date.getUTCFullYear();
			const showYear=index===0 || new Date(dates[index-1]).getUTCFullYear()!==year;
			return <div class="calendar-marker" style={`grid-row: ${index*2+1}`}>
				{showYear && <span class="year-marker">{year}</span>}
				<time datetime={date.toISOString()} data-date-format="month-long">{formatter.format(date)}</time>
			</div>;
		})}
		{dates.flatMap((value,index) => [0,1].map(side => {
			// A period card begins beside its upper (end) boundary; the rail continues
			// down to its real start month. Lane/order assignment still uses start date.
			const items=ordered.filter((project,i) => month(project.data.dateEnd ?? project.data.date)===value && i%2===side);
			return items.length>0 && <div class:list={["timeline-bucket",{"on-left":side===1}]}
				style={`--row: ${index*2+1}; --mobile-row: ${index*2+1+side}`}>
				{items.map(project => <div class="timeline-card" style={`--order: ${ordered.indexOf(project)}`}>
					<div class="mobile-date"><ProjectDate date={project.data.date} dateEnd={project.data.dateEnd} short /></div>
					<span class="card-connector" aria-hidden="true"></span>
					{project.data.dateEnd && <span class="period-label">Project period</span>}
					<ul aria-label={`Project: ${project.data.title}`}><ProjectCard project={project}/></ul>
				</div>)}
			</div>;
		}))}
	</div>
</div>
<style>
.project-timeline{margin-top:1.5rem}
.timeline-intro,.timeline-note{color:var(--color-muted);line-height:1.6}
.timeline-intro{font-size:.85rem;margin:0}
.timeline-note{font-size:.75rem;margin:.35rem 0 2rem}
.timeline-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 9rem minmax(0,1fr);isolation:isolate;padding-bottom:2rem}
.timeline-grid::before{content:"";position:absolute;left:50%;top:52px;bottom:0;width:1px;background:linear-gradient(var(--color-border),var(--color-muted) 20%,var(--color-border) 95%,transparent);z-index:-2}
.calendar-marker{grid-column:2;position:relative;min-height:100px;text-align:center;padding-top:43px;z-index:2;pointer-events:none}
.calendar-marker time{display:inline-block;padding:4px 6px;border-radius:5px;background:var(--color-background);color:var(--color-muted);font-size:.72rem;line-height:1.5}
.year-marker{position:absolute;top:0;left:50%;transform:translateX(-50%);padding:.4rem .85rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-background);color:var(--color-accent);font-size:.75rem;font-weight:750}
.timeline-bucket{grid-column:3;grid-row:var(--row);display:grid;gap:2.5rem;min-width:0;align-content:start;padding:43px 0 3rem}
.timeline-bucket.on-left{grid-column:1}
.timeline-card{position:relative;min-width:0}
.mobile-date{display:none}
.timeline-card ul{list-style:none;margin:0;padding:0}
.period-label{display:block;margin:0 0 .5rem;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--color-accent)}
.card-connector{position:absolute;right:100%;top:10px;width:1.25rem;height:1px;background:var(--color-border)}
.card-connector::after{content:"";position:absolute;left:-3px;top:-3px;width:7px;height:7px;border-radius:50%;background:var(--color-accent)}
.on-left .card-connector{right:auto;left:100%}
.on-left .card-connector::after{left:auto;right:-3px}
.period-rail{grid-column:2;width:0;justify-self:end;margin-right:calc(16px + var(--lane)*8px);border-left:2px dashed var(--color-accent);margin-top:52px;margin-bottom:-52px;position:relative;opacity:.6;pointer-events:none;z-index:-1}
.period-rail.on-left{justify-self:start;margin-right:0;margin-left:calc(16px + var(--lane)*8px)}
.period-rail i{position:absolute;width:10px;height:2px;background:var(--color-accent);left:-6px}
.period-rail i:first-child{top:0}.period-rail i:last-child{bottom:0}
@media(max-width:48rem){
.timeline-grid{display:flex;flex-direction:column;gap:2rem;padding-left:1.25rem}
.timeline-grid::before{left:.25rem;top:0}
.calendar-marker,.period-rail,.period-rail.on-left{display:none}
.timeline-bucket,.timeline-bucket.on-left{display:contents}
.timeline-card{order:var(--order)}
.mobile-date{display:block;margin-bottom:.65rem;color:var(--color-muted);font-size:.7rem}
.mobile-date::before{content:"";position:absolute;left:-1.25rem;top:.75rem;width:.5rem;height:.5rem;border-radius:50%;background:var(--color-accent)}
.period-label,.card-connector,.on-left .card-connector{display:none}
.timeline-card :global(.project-meta .project-date){display:none}
.calendar-marker{grid-column:1;text-align:left;padding-left:.85rem}
.calendar-marker time{font-size:.65rem;max-width:5rem}
.year-marker{left:.5rem;transform:none;padding:.35rem .6rem}
.timeline-bucket,.timeline-bucket.on-left{grid-column:2;grid-row:var(--mobile-row)}
.timeline-bucket.on-left{padding-top:0}
.period-rail,.period-rail.on-left{grid-column:1;justify-self:start;margin-right:0;margin-left:calc(.5rem + 5px + var(--mobile-lane)*4px)}
.card-connector,.on-left .card-connector{left:auto;right:100%;width:.5rem}
.on-left .card-connector::after{right:auto;left:-3px}
}
@media(max-width:25rem){
.timeline-grid{grid-template-columns:5.5rem minmax(0,1fr)}
.calendar-marker time{font-size:.6rem;max-width:4.4rem}
}
</style>
