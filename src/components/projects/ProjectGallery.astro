---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../ui/Icon.astro";
import CollapsibleSection from "../ui/CollapsibleSection.astro";

interface GalleryItem {
	image: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	items: GalleryItem[];
	projectTitle: string;
	sectionKey?: string;
	open?: boolean;
}

const { items, projectTitle, sectionKey = "gallery", open = false } = Astro.props;
---

<CollapsibleSection title="Selected visuals" icon="images" count={items.length} section={sectionKey} open={open}>
	<project-gallery class="project-gallery">
		<ul class:list={{ single: items.length === 1 }}>
		{
			items.map((item, index) => (
				<li>
					<figure>
						<button
							type="button"
							data-gallery-open
							data-full-src={item.image.src}
							data-alt={item.alt}
							data-caption={item.caption ?? ""}
							aria-label={`Open image ${index + 1} of ${items.length}`}
						>
							<Image src={item.image} alt={item.alt} loading="lazy" />
							<span class="view-label" aria-hidden="true">
								<Icon name="maximize-2" size={14} /> View
							</span>
						</button>

						{item.caption && <figcaption>{item.caption}</figcaption>}
					</figure>
				</li>
			))
		}
		</ul>

		<dialog data-gallery-dialog aria-label={`${projectTitle} image viewer`}>
			<div class="viewer-panel">
				<button type="button" class="viewer-close" data-gallery-close aria-label="Close image viewer">
					<Icon name="plus" size={22} />
				</button>

				<img data-gallery-image alt="" />
				<p data-gallery-caption hidden></p>
			</div>
		</dialog>
	</project-gallery>
</CollapsibleSection>

<script>
	class ProjectGalleryElement extends HTMLElement {
		connectedCallback() {
			const dialog = this.querySelector<HTMLDialogElement>("[data-gallery-dialog]");
			const viewerImage = this.querySelector<HTMLImageElement>("[data-gallery-image]");
			const viewerCaption = this.querySelector<HTMLParagraphElement>("[data-gallery-caption]");
			const closeButton = this.querySelector<HTMLButtonElement>("[data-gallery-close]");

			if (!dialog || !viewerImage || !viewerCaption || !closeButton) return;

			this.querySelectorAll<HTMLButtonElement>("[data-gallery-open]").forEach((button) => {
				button.addEventListener("click", () => {
					viewerImage.src = button.dataset.fullSrc ?? "";
					viewerImage.alt = button.dataset.alt ?? "";

					const caption = button.dataset.caption ?? "";
					viewerCaption.textContent = caption;
					viewerCaption.hidden = caption.length === 0;

					dialog.showModal();
				});
			});

			closeButton.addEventListener("click", () => dialog.close());

			dialog.addEventListener("click", (event) => {
				if (event.target === dialog) dialog.close();
			});

			dialog.addEventListener("close", () => {
				viewerImage.removeAttribute("src");
				viewerImage.alt = "";
			});
		}
	}

	if (!customElements.get("project-gallery")) {
		customElements.define("project-gallery", ProjectGalleryElement);
	}
</script>

<style>
	.project-gallery {
		display: block;
	}

	ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 3vw, 2rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul.single { grid-template-columns: minmax(0, 1fr); }

	figure {
		margin: 0;
	}

	figure > button {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		overflow: hidden;
		color: var(--color-text);
		border: 0;
		border-radius: 0.4rem;
		background: transparent;
		cursor: zoom-in;
	}

	figure > button:focus-visible,
	.viewer-close:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
		max-height: 75svh;
		object-fit: contain;
		transition:
			transform 300ms ease,
			filter 300ms ease;
	}

	figure > button:hover :global(img) {
		transform: scale(1.015);
		filter: brightness(0.75);
	}

	.view-label {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.45rem 0.7rem;
		color: var(--color-background);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		border-radius: 999px;
		background: var(--color-accent);
		opacity: 0;
		transform: translateY(0.4rem);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.view-label {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	figure > button:hover > .view-label,
	figure > button:focus-visible > .view-label {
		opacity: 1;
		transform: translateY(0);
	}

	figcaption {
		margin-top: 0.75rem;
		color: var(--color-muted);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	dialog {
		width: min(calc(100% - 2rem), 90rem);
		max-width: none;
		max-height: calc(100dvh - 2rem);
		padding: 0;
		overflow: visible;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-background);
	}

	dialog::backdrop {
		background: rgb(0 0 0 / 0.88);
		backdrop-filter: blur(0.35rem);
	}

	.viewer-panel {
		position: relative;
		display: grid;
		max-height: calc(100dvh - 2rem);
		overflow: auto;
	}

	.viewer-panel > img {
		display: block;
		width: 100%;
		max-height: calc(100dvh - 7rem);
		object-fit: contain;
		background: #050505;
	}

	.viewer-close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.75rem;
		aspect-ratio: 1;
		padding: 0;
		color: #0e0e0e;
		font-size: 1.75rem;
		line-height: 1;
		border: 0;
		border-radius: 50%;
		background: #fdfcfc;
		cursor: pointer;
	}

	.viewer-close :global(svg) {
		transform: rotate(45deg);
	}

	.viewer-panel > p {
		margin: 0;
		padding: 1rem 1.25rem;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	@media (max-width: 44rem) {
		ul {
			grid-template-columns: 1fr;
		}

		.view-label {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		figure :global(img),
		.view-label {
			transition: none;
		}
	}
</style>
