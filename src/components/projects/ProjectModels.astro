---
import CollapsibleSection from "../ui/CollapsibleSection.astro";

interface ModelItem {
	title: string;
	description?: string;
	kind: "demo" | "glb";
	src?: string;
	autoRotate: boolean;
}

interface Props {
	items: ModelItem[];
}

const { items } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const modelUrl = (src?: string) => src
	? (/^https?:\/\//.test(src) ? src : `${baseUrl}${src.replace(/^\/+/, "")}`)
	: undefined;
---

<CollapsibleSection title="3D viewer" icon="box" count={items.length} section="models">
	<div class="model-list">
		{
			items.map((item) => (
				<article class="model-card">
					<header>
						<div>
							<h3>{item.title}</h3>
							{item.description && <p>{item.description}</p>}
						</div>
						<span>{item.kind === "demo" ? "Demo scene" : "glTF / GLB"}</span>
					</header>

					<project-model-viewer data-auto-rotate={String(item.autoRotate)} data-model-src={modelUrl(item.src)}>
						<div
							class="model-viewport"
							data-model-viewport
							role="img"
							aria-label={`Interactive 3D view: ${item.title}`}
						>
							<p data-model-status role="status">Open section to load 3D preview.</p>
						</div>

						<div class="model-controls" aria-label="3D viewer controls">
							<label class="display-mode">
								Display
								<select data-display-mode disabled>
									<option value="original">Original materials</option>
									<option value="neutral">Neutral material</option>
									<option value="wireframe">Wireframe</option>
								</select>
							</label>
							<button type="button" data-retry-viewer hidden>Retry 3D preview</button>
							<button type="button" data-toggle-rotation aria-pressed="true" disabled>
								Pause rotation
							</button>
							<button type="button" data-reset-camera disabled>Reset view</button>
						</div>
					</project-model-viewer>
				</article>
			))
		}
	</div>
</CollapsibleSection>

<script>
	class ProjectModelViewerElement extends HTMLElement {
		initialized = false;
		cleanup: (() => void) | undefined;
		setRendering: ((active: boolean) => void) | undefined;

		connectedCallback() {
			const details = this.closest("details");

			if (!details) return;
			this.querySelector("[data-retry-viewer]")?.addEventListener("click", () => {
				void this.initialize();
			});

			const handleToggle = () => {
				if (details.open) {
					void this.initialize();
				} else {
					this.setRendering?.(false);
				}
			};

			details.addEventListener("toggle", handleToggle);
			this.cleanup = () => details.removeEventListener("toggle", handleToggle);

			if (details.open) void this.initialize();
		}

		disconnectedCallback() {
			this.setRendering?.(false);
			this.cleanup?.();
		}

		async initialize() {
			if (this.initialized) {
				this.setRendering?.(true);
				return;
			}

			this.initialized = true;

			const viewport = this.querySelector<HTMLElement>("[data-model-viewport]");
			const status = this.querySelector<HTMLElement>("[data-model-status]");
			const rotationButton = this.querySelector<HTMLButtonElement>("[data-toggle-rotation]");
			const resetButton = this.querySelector<HTMLButtonElement>("[data-reset-camera]");
			const retryButton = this.querySelector<HTMLButtonElement>("[data-retry-viewer]");
			const displayMode = this.querySelector<HTMLSelectElement>("[data-display-mode]");

			if (!viewport || !status || !rotationButton || !resetButton) return;

			status.textContent = "Loading 3D preview…";
			viewport.replaceChildren(status);
			if (retryButton) retryButton.hidden = true;
			let stage = "loading";
			let releaseResources: (() => void) | undefined;

			try {
				const [THREE, { OrbitControls }] = await Promise.all([
					import("three"),
					import("three/addons/controls/OrbitControls.js"),
				]);

				const scene = new THREE.Scene();
				scene.background = new THREE.Color(0x0e0e0e);
				let loadedModel: import("three").Group | undefined;
				if (this.dataset.modelSrc) {
					stage = "model";
					status.textContent = "Loading 3D model…";
					const { GLTFLoader } = await import("three/addons/loaders/GLTFLoader.js");
					const gltf = await new GLTFLoader().loadAsync(this.dataset.modelSrc);
					loadedModel = gltf.scene;
					loadedModel.traverse((node) => {
						if (node instanceof THREE.Mesh && !node.geometry.attributes.normal) {
							node.geometry.computeVertexNormals();
						}
					});
					const bounds = new THREE.Box3().setFromObject(loadedModel);
					const size = bounds.getSize(new THREE.Vector3());
					const extent = Math.max(size.x, size.y, size.z);
					if (!Number.isFinite(extent) || extent <= 0) throw new Error("Model has no visible geometry");
					const center = bounds.getCenter(new THREE.Vector3());
					const wrapper = new THREE.Group();
					wrapper.add(loadedModel);
					loadedModel.position.sub(center);
					wrapper.scale.setScalar(2.5 / extent);
					scene.add(wrapper);
				}

				const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
				const defaultCameraPosition = new THREE.Vector3(3.6, 2.5, 4.6);
				camera.position.copy(defaultCameraPosition);

				stage = "graphics";
				const canvas = document.createElement("canvas");
				let context = canvas.getContext("webgl2", { antialias: true });
				if (!context) context = canvas.getContext("webgl2", { antialias: false });
				if (!context) throw new Error("WebGL 2 context could not be created");
				const renderer = new THREE.WebGLRenderer({ canvas, context });
				renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
				renderer.outputColorSpace = THREE.SRGBColorSpace;
				renderer.domElement.setAttribute("aria-label", "Interactive 3D canvas");
				viewport.append(renderer.domElement);
				status.hidden = true;
				stage = "scene";

				const hemisphereLight = new THREE.HemisphereLight(0xffffff, 0x202020, 2.4);
				const keyLight = new THREE.DirectionalLight(0xffffff, 3.2);
				keyLight.position.set(4, 6, 3);
				scene.add(hemisphereLight, keyLight);

				const geometry = new THREE.IcosahedronGeometry(1.25, 2);
				const material = new THREE.MeshStandardMaterial({
					color: 0xe8e8e8,
					metalness: 0.15,
					roughness: 0.38,
				});
				const object = new THREE.Mesh(geometry, material);
				object.position.y = 0.2;
				object.visible = !loadedModel;
				scene.add(object);

				const edgeGeometry = new THREE.EdgesGeometry(geometry, 18);
				const edgeMaterial = new THREE.LineBasicMaterial({ color: 0x4a4a4a });
				const edges = new THREE.LineSegments(edgeGeometry, edgeMaterial);
				object.add(edges);

				const originalMaterials = new Map<import("three").Mesh, import("three").Material | import("three").Material[]>();
				(loadedModel ?? object).traverse((node) => {
					if (node instanceof THREE.Mesh) originalMaterials.set(node, node.material);
				});
				const neutralMaterial = new THREE.MeshStandardMaterial({
					color: 0xbdbdbd, metalness: 0, roughness: 0.75, side: THREE.DoubleSide,
				});
				const wireframeMaterial = new THREE.MeshBasicMaterial({
					color: 0xe8e8e8, wireframe: true,
				});
				const applyDisplayMode = () => {
					const mode = displayMode?.value ?? "original";
					originalMaterials.forEach((original, mesh) => {
						mesh.material = mode === "neutral" ? neutralMaterial
							: mode === "wireframe" ? wireframeMaterial : original;
					});
					edges.visible = mode === "original";
				};
				displayMode?.addEventListener("change", applyDisplayMode);

				const grid = new THREE.GridHelper(8, 16, 0x444444, 0x242424);
				grid.position.y = -1.3;
				scene.add(grid);

				const controls = new OrbitControls(camera, renderer.domElement);
				controls.enableDamping = true;
				controls.dampingFactor = 0.06;
				controls.minDistance = 2.5;
				controls.maxDistance = 10;
				controls.target.set(0, 0, 0);

				controls.autoRotate = this.dataset.autoRotate === "true";
				controls.autoRotateSpeed = 1.2;

				const updateRotationButton = () => {
					rotationButton.textContent = controls.autoRotate ? "Pause rotation" : "Start rotation";
					rotationButton.setAttribute("aria-pressed", String(controls.autoRotate));
				};

				updateRotationButton();

				const stopAutoRotation = () => {
					controls.autoRotate = false;
					updateRotationButton();
				};
				controls.addEventListener("start", stopAutoRotation);

				const toggleRotation = () => {
					controls.autoRotate = !controls.autoRotate;
					updateRotationButton();
				};
				rotationButton.addEventListener("click", toggleRotation);

				const resetCamera = () => {
					stopAutoRotation();
					camera.position.copy(defaultCameraPosition);
					controls.target.set(0, 0, 0);
					controls.update();
				};
				resetButton.addEventListener("click", resetCamera);

				const resize = () => {
					const width = viewport.clientWidth;
					const height = viewport.clientHeight;

					if (width === 0 || height === 0) return;

					camera.aspect = width / height;
					camera.updateProjectionMatrix();
					renderer.setSize(width, height, false);
				};

				const resizeObserver = new ResizeObserver(resize);
				resizeObserver.observe(viewport);
				resize();

				const renderFrame = () => {
					controls.update();
					renderer.render(scene, camera);
				};

				this.setRendering = (active) => {
					renderer.setAnimationLoop(active && !document.hidden && !context.isContextLost() ? renderFrame : null);
				};
				const resumeRendering = () => this.setRendering?.(this.closest("details")?.open === true);
				const contextLost = (event: Event) => {
					event.preventDefault();
					this.setRendering?.(false);
					status.hidden = false;
					status.textContent = "Graphics interrupted. Waiting to restore the 3D view…";
				};
				const contextRestored = () => {
					status.hidden = true;
					resumeRendering();
				};
				canvas.addEventListener("webglcontextlost", contextLost);
				canvas.addEventListener("webglcontextrestored", contextRestored);
				document.addEventListener("visibilitychange", resumeRendering);

				const removeToggleListener = this.cleanup;
				releaseResources = () => {
					renderer.setAnimationLoop(null);
					displayMode?.removeEventListener("change", applyDisplayMode);
					originalMaterials.forEach((original, mesh) => { mesh.material = original; });
					neutralMaterial.dispose();
					wireframeMaterial.dispose();
					rotationButton.removeEventListener("click", toggleRotation);
					resetButton.removeEventListener("click", resetCamera);
					canvas.removeEventListener("webglcontextlost", contextLost);
					canvas.removeEventListener("webglcontextrestored", contextRestored);
					document.removeEventListener("visibilitychange", resumeRendering);
					resizeObserver.disconnect();
					controls.removeEventListener("start", stopAutoRotation);
					controls.dispose();
					geometry.dispose();
					material.dispose();
					edgeGeometry.dispose();
					edgeMaterial.dispose();
					grid.geometry.dispose();
					const gridMaterials = Array.isArray(grid.material) ? grid.material : [grid.material];
					gridMaterials.forEach((item) => item.dispose());
					loadedModel?.traverse((node) => {
						if (!(node instanceof THREE.Mesh)) return;
						node.geometry.dispose();
						const materials = Array.isArray(node.material) ? node.material : [node.material];
						materials.forEach((item) => {
							Object.values(item).forEach((value) => {
								if (value instanceof THREE.Texture) value.dispose();
							});
							item.dispose();
						});
					});
					renderer.dispose();
				};
				this.cleanup = () => {
					removeToggleListener?.();
					releaseResources?.();
				};

				renderFrame();
				rotationButton.disabled = false;
				resetButton.disabled = false;
				if (displayMode) displayMode.disabled = false;
				resumeRendering();
			} catch (error) {
				releaseResources?.();
				this.setRendering = undefined;
				this.initialized = false;
				status.hidden = false;
				viewport.replaceChildren(status);
				status.textContent = stage === "graphics"
					? "WebGL 2 is unavailable. Check browser graphics acceleration and your graphics driver, then retry."
					: stage === "loading"
						? "Could not load the 3D viewer. Check your connection and reload this page, or retry."
						: stage === "model"
							? "Could not load this model. Check the model file and its textures, then retry."
							: "Could not start the 3D scene. Please retry.";
				console.error(`[Portfolio 3D: ${stage}]`, error);
				rotationButton.disabled = true;
				resetButton.disabled = true;
				if (displayMode) displayMode.disabled = true;
				if (retryButton) retryButton.hidden = false;
			}
		}
	}

	if (!customElements.get("project-model-viewer")) {
		customElements.define("project-model-viewer", ProjectModelViewerElement);
	}
</script>

<style>
	.model-list {
		display: grid;
		gap: 1.5rem;
	}

	.model-card {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}

	.model-card > header {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--color-border);
	}

	.model-card > header > div {
		display: grid;
		gap: 0.35rem;
	}

	h3,
	p {
		margin: 0;
	}

	h3 {
		font-size: 1rem;
	}

	p {
		color: var(--color-muted);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.model-card > header > span {
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	project-model-viewer {
		display: block;
	}

	.model-viewport {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 18rem;
		background: #0e0e0e;
		touch-action: none;
	}

	.model-viewport :global(canvas) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.model-viewport > p {
		position: absolute;
		z-index: 1;
		max-width: 32rem;
		padding: 1.5rem;
		text-align: center;
	}

	.model-viewport > p[hidden],
	button[hidden] {
		display: none;
	}

	button:disabled {
		opacity: 0.45;
		cursor: default;
	}

	.model-controls {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		flex-wrap: wrap;
		gap: 0.65rem;
		padding: 0.85rem 1rem;
		border-top: 1px solid var(--color-border);
	}

	button {
		padding: 0.5rem 0.8rem;
		color: var(--color-text);
		font: inherit;
		font-size: 0.72rem;
		font-weight: 700;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
	}

	.display-mode {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-right: auto;
		color: var(--color-muted);
		font-size: 0.75rem;
	}

	select {
		max-width: 100%;
		padding: 0.5rem 0.7rem;
		color: var(--color-text);
		font: inherit;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		background: var(--color-surface);
	}

	select:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.2rem;
	}

	button:hover {
		border-color: var(--color-accent);
	}

	button:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.2rem;
	}

	@media (max-width: 36rem) {
		.model-card > header {
			flex-direction: column;
			gap: 0.65rem;
		}

		.model-viewport {
			aspect-ratio: 4 / 3;
			min-height: 15rem;
		}
	}
</style>
