---
import type { ImageMetadata } from "astro";
import CollapsibleSection from "../ui/CollapsibleSection.astro";

interface VideoSource {
	src: string;
	type: "video/mp4" | "video/webm";
}

interface VideoItem {
	title: string;
	caption?: string;
	poster?: ImageMetadata;
	preload: "none" | "metadata" | "auto";
	loop: boolean;
	muted: boolean;
	sources: VideoSource[];
}

interface Props {
	items: VideoItem[];
}

const { items } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

function resolveMediaUrl(src: string): string {
	if (/^(?:https?:)?\/\//.test(src)) return src;

	return `${baseUrl}${src.replace(/^\/+/, "")}`;
}
---

<CollapsibleSection title="Video" icon="clapperboard" count={items.length} section="video">
	<ul>
		{
			items.map((item) => (
				<li>
					<figure>
						<video
							controls
							playsinline
							preload={item.preload}
							poster={item.poster?.src}
							loop={item.loop}
							muted={item.muted}
							aria-label={item.title}
						>
							{item.sources.map((source) => (
								<source src={resolveMediaUrl(source.src)} type={source.type} />
							))}

							Your browser does not support HTML video. You can
							<a href={resolveMediaUrl(item.sources[0].src)}>open the video file</a>.
						</video>

						<figcaption>
							<strong>{item.title}</strong>
							{item.caption && <span>{item.caption}</span>}
						</figcaption>
					</figure>
				</li>
			))
		}
	</ul>
</CollapsibleSection>

<style>
	ul {
		display: grid;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	figure {
		margin: 0;
	}

	video {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: contain;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: #050505;
	}

	figcaption {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.85rem;
		line-height: 1.5;
	}

	figcaption strong {
		font-size: 0.95rem;
	}

	figcaption span {
		color: var(--color-muted);
		font-size: 0.85rem;
	}
</style>
