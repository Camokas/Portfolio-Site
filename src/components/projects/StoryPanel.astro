---
import Icon from "../ui/Icon.astro";
import type { IconName } from "../../data/icons";
const panels = {
  "youtube-channel": {
    icon: "clapperboard", label: "Channel formats",
    items: [["107", "YouTube Shorts"], ["Music", "Original soundtrack visualisers"], ["Misform", "Trailer for itch.io"]],
  },
  "feedback": {
    icon: "gamepad-2", label: "Changes shaped by players",
    items: [["Play", "Sound & multiplayer"], ["Fix", "Bugs & compatibility"], ["Expand", "New blocks & creatures"]],
  },
  "youtube-audience": {
    icon: "compass", label: "Owner-reported · 31 October 2026",
    items: [["1,020", "YouTube subscribers"]],
  },
  "tiktok-audience": {
    icon: "compass", label: "Owner-reported · 31 October 2026",
    items: [["~1.1K", "TikTok followers"], ["~41K", "Likes"]],
  },
  "tiktok-results": {
    icon: "compass", label: "Leading videos · captured statistics",
    items: [["~82K", "TikTok views"], ["39,344", "YouTube views"]],
  },
  "telegram-period": {
    icon: "clock-3", label: "Two chapters",
    items: [["Personal", "November 2024 – June 2025"], ["Public", "June 2025 – October 2026"]],
  },
  "telegram-audience": {
    icon: "gamepad-2", label: "Community size · approximate",
    items: [["~600", "Peak subscribers"], ["~450", "Subscribers at closure"]],
  },
  "portfolio": {
    "icon": "clapperboard",
    "label": "A compact filmmaking practice",
    "items": [
      [
        "107",
        "YouTube Shorts"
      ],
      [
        "2–3 h",
        "Later production time"
      ],
      [
        "Solo",
        "Voice, animation & editing"
      ]
    ]
  },
  "workflow": {
    "icon": "wand-sparkles",
    "label": "From an idea to a finished video",
    "items": [
      [
        "01",
        "Idea & script"
      ],
      [
        "02",
        "Voice & music"
      ],
      [
        "03",
        "Footage & rough cut"
      ],
      [
        "04",
        "Animation & colour"
      ],
      [
        "05",
        "Final timing & render"
      ]
    ]
  },
  "solo": {
    "icon": "person-standing",
    "label": "One creator, many disciplines",
    "items": [
      [
        "Voice",
        "My own narration"
      ],
      [
        "Visuals",
        "Graphics & animation"
      ],
      [
        "Edit",
        "Picture, sound & delivery"
      ]
    ]
  },
  "time": {
    "icon": "clock-3",
    "label": "A more efficient process",
    "items": [
      [
        "~6 h",
        "Early YouTube Short"
      ],
      [
        "2–3 h",
        "Later YouTube Short"
      ],
      [
        "~1 h",
        "Typical TikTok"
      ]
    ]
  },
  "tools": {
    "icon": "layout-grid",
    "label": "A connected creative workflow",
    "items": [
      [
        "OBS",
        "Capture"
      ],
      [
        "Premiere Pro",
        "Edit"
      ],
      [
        "After Effects",
        "Animate"
      ],
      [
        "Adobe Audition",
        "Process voice"
      ],
      [
        "Media Encoder",
        "Render"
      ]
    ]
  },
  "voice": {
    "icon": "audio-lines",
    "label": "A reusable voice-processing chain",
    "items": [
      [
        "Clean",
        "Reduce echo & noise"
      ],
      [
        "Shape",
        "Adjust tone & frequencies"
      ],
      [
        "Reuse",
        "Save the processing chain"
      ]
    ]
  },
  "camera": {
    "icon": "images",
    "label": "The recording setup evolved",
    "items": [
      [
        "01",
        "Realme C55"
      ],
      [
        "02",
        "Poco X6 Pro 5G"
      ],
      [
        "03",
        "Pixel 7 Pro"
      ]
    ]
  },
  "community": {
    "icon": "gamepad-2",
    "label": "A conversation around development",
    "items": [
      [
        "Share",
        "Updates & test builds"
      ],
      [
        "Listen",
        "Polls & discussions"
      ],
      [
        "Improve",
        "Bugs, sound & multiplayer"
      ]
    ]
  },
  "reach": {
    "icon": "compass",
    "label": "Two different rhythms",
    "items": [
      [
        "YouTube",
        "Narration & animation"
      ],
      [
        "TikTok",
        "A concise idea & fast cuts"
      ],
      [
        "Telegram",
        "A shared development diary"
      ]
    ]
  }
} as const;
interface Props { kind?: keyof typeof panels; }
const {kind = "workflow"} = Astro.props;
const panel = panels[kind];
---
<aside class="story-panel" aria-label={panel.label}>
	<Icon name={panel.icon as IconName} size={30}/>
	<p class="panel-title">{panel.label}</p>
	<ol>{panel.items.map(([value,label])=><li><strong>{value}</strong><span>{label}</span></li>)}</ol>
</aside>
<style>
.story-panel{padding:clamp(1.25rem,3vw,2.5rem);border-radius:.75rem;background:linear-gradient(145deg,#131313,transparent);min-width:0}
.story-panel :global(svg){color:var(--color-accent)}
.panel-title{font-size:.8rem;color:var(--color-muted);margin:.75rem 0 1.5rem;line-height:1.5}
ol{list-style:none;padding:0;margin:0;display:grid;gap:1.1rem}
li{display:grid;grid-template-columns:minmax(4rem,.65fr) minmax(0,1fr);gap:1rem;align-items:baseline}
strong{font-size:clamp(1rem,1.8vw,1.3rem);line-height:1.35;letter-spacing:-.02em;color:var(--color-text)}
span{font-size:.85rem;line-height:1.5;color:var(--color-muted)}
</style>

