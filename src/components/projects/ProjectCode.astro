---
import { Code } from "astro:components";
import CollapsibleSection from "../ui/CollapsibleSection.astro";
import Icon from "../ui/Icon.astro";

type CodeLanguage =
	| "astro"
	| "bash"
	| "cpp"
	| "csharp"
	| "css"
	| "glsl"
	| "hlsl"
	| "shaderlab"
	| "html"
	| "js"
	| "json"
	| "plaintext"
	| "python"
	| "ts";

interface CodeSample {
	title: string;
	filename: string;
	language: CodeLanguage;
	code: string;
	description?: string;
}

interface Props {
	items: CodeSample[];
	sectionKey?: string;
	open?: boolean;
}

const { items, sectionKey = "code", open = false } = Astro.props;
---

<CollapsibleSection title="Code" icon="code-2" count={items.length} section={sectionKey} open={open}>
	<div class="code-list">
		{
			items.map((item, index) => (
				<code-sample class="code-sample" data-code-key={`${sectionKey}:${item.filename}:${index}`}>
					<details>
						<summary>
							<div class="sample-copy">
								<h3>{item.title}</h3>
								<p>{item.filename} · {item.language}</p>
								{item.description && <p>{item.description}</p>}
							</div>
							<span class="code-chevron" aria-hidden="true"><Icon name="chevron-down" size={18} /></span>
						</summary>
					<header>
						<div>
							<p>{item.filename}</p>
							<span>{item.language}</span>
						</div>

						<button type="button" data-copy-code>Copy code</button>
					</header>

					<div class="code-block">
						<Code code={item.code.trim()} lang={item.language} theme="github-dark" tabindex="0" role="region" aria-label={`Code: ${item.filename}`} />
					</div>
					</details>
				</code-sample>
			))
		}
	</div>
</CollapsibleSection>

<script>
	class CodeSampleElement extends HTMLElement {
		connectedCallback() {
			const details = this.querySelector("details");
			const storageKey = `portfolio-code:${location.pathname}:${this.dataset.codeKey}`;
			if (details) {
				try { details.open = localStorage.getItem(storageKey) === "open"; } catch { /* Keep default closed. */ }
				details.addEventListener("toggle", () => {
					try { localStorage.setItem(storageKey, details.open ? "open" : "closed"); } catch { /* Optional persistence. */ }
				});
			}
			const button = this.querySelector<HTMLButtonElement>("[data-copy-code]");
			const code = this.querySelector("pre code");

			if (!button || !code) return;

			button.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(code.textContent ?? "");
					button.textContent = "Copied";
					setTimeout(() => {
						button.textContent = "Copy code";
					}, 1600);
				} catch {
					button.textContent = "Copy failed";
				}
			});
		}
	}

	if (!customElements.get("code-sample")) {
		customElements.define("code-sample", CodeSampleElement);
	}
</script>

<style>
	.code-list {
		display: grid;
		gap: 1.5rem;
		margin-top: 0;
	}

	.code-sample {
		display: block;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}
	summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; cursor: pointer; list-style: none; }
	summary::-webkit-details-marker { display: none; }
	summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -3px; }
	.code-chevron { flex-shrink: 0; margin-right: 1rem; transition: transform 180ms ease; }
	details[open] .code-chevron { transform: rotate(180deg); }

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	header > div {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	header p,
	header span,
	.sample-copy h3,
	.sample-copy p {
		margin: 0;
	}

	header p {
		overflow: hidden;
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.8rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	header span {
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	button {
		padding: 0.45rem 0.7rem;
		color: var(--color-text);
		font: inherit;
		font-size: 0.7rem;
		font-weight: 700;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
	}

	button:hover {
		border-color: var(--color-accent);
	}

	button:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.2rem;
	}

	.sample-copy {
		display: grid;
		gap: 0.35rem;
		padding: 1rem;
	}

	.sample-copy h3 {
		font-size: 1rem;
	}

	.sample-copy p {
		color: var(--color-muted);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.code-block {
		border-top: 1px solid var(--color-border);
	}
	.code-block :global(pre:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: -2px; }

	.code-block :global(.astro-code) {
		margin: 0;
		padding: 1.25rem;
		overflow: auto;
		font-size: 0.82rem;
		line-height: 1.7;
		tab-size: 2;
	}
</style>
