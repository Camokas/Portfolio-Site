---
import Icon from "../ui/Icon.astro";
import CollapsibleSection from "../ui/CollapsibleSection.astro";

interface DownloadItem {
	label: string;
	file: string;
	description?: string;
	format: string;
	size?: string;
}

interface ExternalLink {
	label: string;
	href: string;
	description?: string;
	kind: "website" | "source" | "demo" | "store" | "documentation";
}

interface Props {
	downloads: DownloadItem[];
	links: ExternalLink[];
	sectionKey?: string;
	open?: boolean;
}

const { downloads, links, sectionKey = "resources", open = false } = Astro.props;
const downloadsId = `${sectionKey}-downloads-title`;
const linksId = `${sectionKey}-links-title`;
const baseUrl = import.meta.env.BASE_URL;

function resolveDownloadUrl(file: string): string {
	return `${baseUrl}${file.replace(/^\/+/, "")}`;
}
---

<CollapsibleSection
	title="Resources"
	icon="download"
	count={downloads.length + links.length}
	section={sectionKey}
	open={open}
>
	<div class="resource-groups">
		{
			downloads.length > 0 && (
				<section aria-labelledby={downloadsId}>
					<h3 id={downloadsId}>Downloads</h3>
					<ul>
						{downloads.map((item) => (
							<li>
								<a href={resolveDownloadUrl(item.file)} download>
									<span class="resource-icon" aria-hidden="true">
										<Icon name="download" size={20} />
									</span>

									<span class="resource-copy">
										<strong>{item.label}</strong>
										{item.description && <span>{item.description}</span>}
									</span>

									<span class="resource-meta">
										{item.format}{item.size && ` · ${item.size}`}
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			links.length > 0 && (
				<section aria-labelledby={linksId}>
					<h3 id={linksId}>External links</h3>
					<ul>
						{links.map((item) => (
							<li>
								<a href={item.href} target="_blank" rel="noreferrer">
									<span class="resource-icon" aria-hidden="true">
										<Icon name="external-link" size={20} />
									</span>

									<span class="resource-copy">
										<strong>{item.label}</strong>
										{item.description && <span>{item.description}</span>}
									</span>

									<span class="resource-meta">{item.kind}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</CollapsibleSection>

<style>
	.resource-groups h3 {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.resource-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3rem);
		margin-top: 0;
	}

	.resource-groups section {
		display: grid;
		align-content: start;
		gap: 1rem;
	}

	ul {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	a:hover {
		transform: translateY(-0.15rem);
		border-color: var(--color-accent);
	}

	a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.resource-icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		aspect-ratio: 1;
		color: var(--color-accent);
		border: 1px solid var(--color-border);
		border-radius: 50%;
	}

	.resource-copy {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.resource-copy strong {
		font-size: 0.95rem;
	}

	.resource-copy > span {
		color: var(--color-muted);
		font-size: 0.8rem;
		line-height: 1.45;
	}

	.resource-meta {
		color: var(--color-muted);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	@media (max-width: 48rem) {
		.resource-groups {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 30rem) {
		a {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.resource-meta {
			grid-column: 2;
		}
	}
</style>
