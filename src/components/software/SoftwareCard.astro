---
import type { Software } from "../../data/software";
import { softwareLogo, softwareUrl } from "../../data/software";
import SoftwarePattern from "./SoftwarePattern.astro";
import Icon from "../ui/Icon.astro";
interface Props { tool: Software; }
const {tool} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<li class="software-item">
	<a class="software-card" href={softwareUrl(tool.slug, base)}>
		<SoftwarePattern slugs={[tool.slug]} />
		<div class="card-top"><img class="mark" src={softwareLogo(tool.slug, base)} alt="" width="40" height="40" loading="lazy" /><span class:list={["status", { previous: tool.status === "Used previously" }]}>{tool.status}</span></div>
		<div class="card-copy"><h3>{tool.title}</h3><p>{tool.summary.en}</p></div>
		<div class="card-bottom">{tool.firstUsed ? <span><span>First used</span> · <span>{tool.firstUsed.en}</span></span> : <span></span>}<Icon name="arrow-right" size={18} /></div>
	</a>
</li>
<style>
.software-item{min-width:0;list-style:none}
.software-card{position:relative;isolation:isolate;display:flex;flex-direction:column;gap:1.5rem;min-height:18rem;height:100%;padding:1.5rem;border:1px solid var(--color-border);border-radius:1rem;background:#131313;color:inherit;text-decoration:none;overflow:hidden;transition:border-color 250ms ease,background 250ms ease}
.software-card::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(160deg,transparent,#101010 90%)}
.card-top,.card-copy,.card-bottom{position:relative}
.card-top,.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:1rem}
.mark{object-fit:contain;filter:brightness(0) invert(1);opacity:.85}
.status{font-size:.68rem;line-height:1.4;color:var(--color-muted);text-align:right}
.previous{opacity:.7}
.card-copy{flex:1}
h3{margin:0 0 .65rem;font-size:1.25rem;line-height:1.3;letter-spacing:-.025em}
p{margin:0;color:var(--color-muted);font-size:.88rem;line-height:1.65}
.card-bottom{font-size:.68rem;color:var(--color-muted);line-height:1.5}
.software-card:hover{border-color:#858585;background:#191919}
.software-card:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
@media(max-width:32rem){.software-card{min-height:16rem}}
</style>
