---
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectionCard from "../components/directions/DirectionCard.astro";
import Icon from "../components/ui/Icon.astro";
import { contactLinks } from "../data/contactLinks";
import { directions } from "../data/directions";
import { home } from "../data/home";
import { getCollection } from "astro:content";
import { projectPreviews } from "../data/projectPreviews";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id));
const mediaByProject = await Promise.all(projects.map(async (project) => ({
	direction: project.data.direction, items: await projectPreviews(project),
})));

---

<BaseLayout
	title={home.pageTitle}
	description={home.pageDescription}
	lang="en"
>
	<main id="main-content" tabindex="-1">
		<section class="hero" aria-labelledby="hero-title">
			<p class="eyebrow">{home.eyebrow}</p>

			<h1 id="hero-title">{home.name}</h1>

			<p class="alias">{home.alias}</p>
		</section>

		<section class="about" aria-label={home.aboutTitle}>
			<details class="about-details">
				<summary>
					<span class="about-heading">
						<span class="about-label">{home.aboutTitle}</span>

						<span class="about-preview">
							{home.aboutPreview}
						</span>
					</span>

					<span class="about-toggle" aria-hidden="true">
						<span class="toggle-open">{home.readMore}</span>
						<span class="toggle-close">{home.showLess}</span>
						<span class="toggle-icon">
							<span class="toggle-plus"><Icon name="plus" size={18} /></span>
							<span class="toggle-minus"><Icon name="minus" size={18} /></span>
						</span>
					</span>
				</summary>

				<div class="about-expanded">
					{home.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</details>
		</section>

		<section
			id="directions"
			class="directions"
			aria-labelledby="directions-title"
		>
			<div class="section-heading">
				<p class="section-kicker">
					<Icon name="compass" size={15} /> {home.directionsKicker}
				</p>

				<h2 id="directions-title">{home.directionsTitle}</h2>

				<p class="section-description">
					{home.directionsDescription}
				</p>
			</div>

			<ul class="direction-grid">
				{
					directions.filter(direction => direction.slug !== "software").map((direction, index) => (
						<DirectionCard
							numberLabel={String(index + 1).padStart(2, "0")}
							title={direction.title}
							description={direction.description}
							slug={direction.slug}
							icon={direction.icon}
							previews={mediaByProject.filter((project) => project.direction === direction.slug).flatMap((project) => project.items)}
						/>
					))
				}
			</ul>
		</section>

		<section id="software" class="software-section" aria-labelledby="software-title">
			<div class="section-heading">
				<h2 id="software-title">Software I Use</h2>
				<p class="section-description">The tools behind my projects and creative workflow.</p>
			</div>
			<ul class="direction-grid">
				{directions.filter(direction => direction.slug === "software").map(direction => (
					<DirectionCard
						numberLabel="↗"
						title={direction.title}
						description={direction.description}
						slug={direction.slug}
						icon={direction.icon}
						previews={mediaByProject.filter(project => project.direction === direction.slug).flatMap(project => project.items)}
					/>
				))}
			</ul>
		</section>

		<section id="contact" class="contact" aria-labelledby="contact-title">
			<div class="contact-heading">
				<p class="section-kicker">
					<Icon name="mail" size={15} /> {home.contactKicker}
				</p>

				<h2 id="contact-title">{home.contactTitle}</h2>
			</div>

			<div class="contact-content">
				<p class="contact-description">
					{home.contactDescription}
				</p>

				<ul class="contact-links">
					{
						contactLinks.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noreferrer">
									<span class="contact-link-icon" aria-hidden="true">
										<Icon name={link.icon} size={20} />
									</span>

									<span class="contact-link-copy">
										<span class="contact-link-name">{link.label}</span>
										<span class="contact-link-detail">{link.detail}</span>
										<span class="contact-link-description">
											{link.description}
										</span>
									</span>

									<span class="contact-link-arrow" aria-hidden="true">
										<Icon name="external-link" size={18} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	main {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
	}

	.hero {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		min-height: clamp(17rem, 38svh, 24rem);
		padding-block: clamp(2.5rem, 7vh, 4rem);
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 12vw, 8.5rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.alias {
		margin: 0.8rem 0 0;
		color: var(--color-muted);
		font-size: clamp(1.2rem, 3vw, 2rem);
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.about {
		border-block: 1px solid var(--color-border);
	}

	.about-details summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem;
		padding-block: clamp(1.5rem, 4vw, 2.25rem);
		cursor: pointer;
		list-style: none;
	}

	.about-details summary::-webkit-details-marker {
		display: none;
	}

	.about-details summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.35rem;
		border-radius: 0.2rem;
	}

	.about-heading {
		display: grid;
		gap: 0.45rem;
	}

	.about-label {
		color: var(--color-accent);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.about-preview {
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.5;
	}

	.about-toggle {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-muted);
		font-size: 0.85rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.toggle-close {
		display: none;
	}

	.toggle-icon {
		display: grid;
		place-items: center;
		width: 2rem;
		aspect-ratio: 1;
		color: var(--color-text);
		font-size: 1.25rem;
		font-weight: 400;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.toggle-minus {
		display: none;
	}

	.about-details summary:hover .toggle-icon {
		border-color: var(--color-accent);
	}

	.about-details[open] .toggle-open {
		display: none;
	}

	.about-details[open] .toggle-close {
		display: inline;
	}

	.about-details[open] .toggle-plus {
		display: none;
	}

	.about-details[open] .toggle-minus {
		display: block;
	}

	.about-expanded {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 4vw, 3rem);
		max-width: 60rem;
		padding: 0 0 clamp(1.75rem, 5vw, 3rem);
		animation: reveal-description 220ms ease-out;
	}

	.about-expanded p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.7;
	}

	.directions {
		scroll-margin-top: 4.5rem;
		padding-block: clamp(2.5rem, 7vw, 6rem);
	}

	.software-section {
		padding-block: clamp(2.5rem, 6vw, 5rem);
		border-top: 1px solid var(--color-border);
		scroll-margin-top: 4.5rem;
	}

	.section-heading {
		display: grid;
		gap: 1rem;
		max-width: 46rem;
	}

	.section-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.section-description {
		margin: 0;
		color: var(--color-muted);
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.direction-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}

	.contact {
		display: grid;
		grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(2rem, 8vw, 7rem);
		scroll-margin-top: 4.5rem;
		padding-block: clamp(3.5rem, 9vw, 7rem);
		border-top: 1px solid var(--color-border);
	}

	.contact-heading {
		display: grid;
		align-content: start;
		gap: 1rem;
	}

	.contact-content {
		display: grid;
		gap: 2rem;
	}

	.contact-description {
		max-width: 40rem;
		margin: 0;
		color: var(--color-muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.contact-links {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contact-links a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 1.5rem;
		padding: 1.25rem 1.5rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.contact-link-icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		aspect-ratio: 1;
		color: var(--color-accent);
		border: 1px solid var(--color-border);
		border-radius: 50%;
	}

	.contact-links a:hover {
		transform: translateX(0.25rem);
		border-color: var(--color-accent);
	}

	.contact-links a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.contact-link-copy {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.35rem 0.75rem;
	}

	.contact-link-name {
		font-weight: 750;
	}

	.contact-link-detail {
		align-self: center;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.contact-link-description {
		grid-column: 1 / -1;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.contact-link-arrow {
		color: var(--color-accent);
		transition: transform 180ms ease;
	}

	.contact-links a:hover .contact-link-arrow {
		transform: translate(0.15rem, -0.15rem);
	}

	@keyframes reveal-description {
		from {
			opacity: 0;
			transform: translateY(-0.4rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 40rem) {
		.about-details summary {
			align-items: end;
			gap: 1rem;
		}

		.about-details .about-toggle .toggle-open,
		.about-details .about-toggle .toggle-close {
			display: none;
		}

		.about-expanded {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 48rem) {
		.contact {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-expanded {
			animation: none;
		}

		.toggle-icon {
			transition: none;
		}
	}
</style>
