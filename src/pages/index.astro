---
import BaseLayout from "../layouts/BaseLayout.astro";
import DirectionCard from "../components/directions/DirectionCard.astro";
import { directions } from "../data/directions";

---

<BaseLayout
	title="Camoka's Portfolio"
	description="Camoka's multimedia portfolio featuring creative and development projects."
	lang="en"
>
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<p class="eyebrow">Portfolio website</p>

			<h1 id="hero-title">Camoka</h1>

			<p class="alias">or Daniil Doroshkin</p>
		</section>

		<section class="about" aria-label="About this portfolio">
			<details class="about-details">
				<summary>
					<span class="about-heading">
						<span class="about-label">About this portfolio</span>

						<span class="about-preview">
							A multidisciplinary collection of creative and development work.
						</span>
					</span>

					<span class="about-toggle" aria-hidden="true">
						<span class="toggle-open">Read more</span>
						<span class="toggle-close">Show less</span>
						<span class="toggle-icon">+</span>
					</span>
				</summary>

				<div class="about-expanded">
					<p>
						I work across software development and digital art, combining
						technical experiments with visual storytelling, sound, motion, and
						interactive ideas.
					</p>

					<p>
						This portfolio brings together finished projects, prototypes,
						studies, and works in progress from every direction I explore.
					</p>
				</div>
			</details>
		</section>

		<section
			id="directions"
			class="directions"
			aria-labelledby="directions-title"
		>
			<div class="section-heading">
				<p class="section-kicker">What I explore</p>

				<h2 id="directions-title">Creative Directions</h2>

				<p class="section-description">
					Nine areas bringing together development, visual art, sound, motion,
					and interactive experiments.
				</p>
			</div>

			<ul class="direction-grid">
				{
					directions.map((direction, index) => (
						<DirectionCard
							numberLabel={String(index + 1).padStart(2, "0")}
							title={direction.title}
							description={direction.description}
							slug={direction.slug}
						/>
					))
				}
			</ul>
		</section>
	</main>
</BaseLayout>

<style>
	main {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
	}

	.hero {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		min-height: clamp(17rem, 38svh, 24rem);
		padding-block: clamp(2.5rem, 7vh, 4rem);
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(4rem, 12vw, 8.5rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.alias {
		margin: 0.8rem 0 0;
		color: var(--color-muted);
		font-size: clamp(1.2rem, 3vw, 2rem);
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.about {
		border-block: 1px solid var(--color-border);
	}

	.about-details summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem;
		padding-block: clamp(1.5rem, 4vw, 2.25rem);
		cursor: pointer;
		list-style: none;
	}

	.about-details summary::-webkit-details-marker {
		display: none;
	}

	.about-details summary:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.35rem;
		border-radius: 0.2rem;
	}

	.about-heading {
		display: grid;
		gap: 0.45rem;
	}

	.about-label {
		color: var(--color-accent);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.about-preview {
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.5;
	}

	.about-toggle {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-muted);
		font-size: 0.85rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.toggle-close {
		display: none;
	}

	.toggle-icon {
		display: grid;
		place-items: center;
		width: 2rem;
		aspect-ratio: 1;
		color: var(--color-text);
		font-size: 1.25rem;
		font-weight: 400;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition:
			transform 180ms ease,
			border-color 180ms ease;
	}

	.about-details summary:hover .toggle-icon {
		border-color: var(--color-accent);
	}

	.about-details[open] .toggle-open {
		display: none;
	}

	.about-details[open] .toggle-close {
		display: inline;
	}

	.about-details[open] .toggle-icon {
		transform: rotate(45deg);
	}

	.about-expanded {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 4vw, 3rem);
		max-width: 60rem;
		padding: 0 0 clamp(1.75rem, 5vw, 3rem);
		animation: reveal-description 220ms ease-out;
	}

	.about-expanded p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.7;
	}

	.directions {
		scroll-margin-top: 4.5rem;
		padding-block: clamp(2.5rem, 7vw, 6rem);
	}

	.section-heading {
		display: grid;
		gap: 1rem;
		max-width: 46rem;
	}

	.section-kicker {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.section-description {
		margin: 0;
		color: var(--color-muted);
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.direction-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}

	@keyframes reveal-description {
		from {
			opacity: 0;
			transform: translateY(-0.4rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 40rem) {
		.about-details summary {
			align-items: end;
			gap: 1rem;
		}

		.about-details .about-toggle .toggle-open,
		.about-details .about-toggle .toggle-close {
			display: none;
		}

		.about-expanded {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-expanded {
			animation: none;
		}

		.toggle-icon {
			transition: none;
		}
	}
</style>
