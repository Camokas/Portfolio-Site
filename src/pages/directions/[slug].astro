---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { directions } from "../../data/directions";
import type { Direction } from "../../data/directions";

export function getStaticPaths() {
	return directions.map((direction) => ({
		params: {
			slug: direction.slug,
		},
		props: {
			direction,
		},
	}));
}

interface Props {
	direction: Direction;
}

const { direction } = Astro.props;
const homeUrl = import.meta.env.BASE_URL;
---

<BaseLayout
	title={`${direction.title} | Camoka's Portfolio`}
	description={direction.description}
	lang="en"
>
	<main class="category-page">
		<a class="back-link" href={homeUrl}>← Back to home</a>

		<header class="category-header">
			<p class="eyebrow">Creative direction</p>

			<h1>{direction.title}</h1>

			<p class="description">{direction.description}</p>
		</header>

		<section class="projects" aria-labelledby="projects-title">
			<h2 id="projects-title">Projects</h2>

			<p class="empty-message">
				Projects in this direction will appear here.
			</p>
		</section>
	</main>
</BaseLayout>

<style>
	.category-page {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
		padding-block: clamp(2rem, 6vw, 5rem);
	}

	.back-link {
		display: inline-block;
		color: var(--color-accent);
		font-weight: 700;
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.back-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.category-header {
		display: grid;
		gap: 1.25rem;
		max-width: 52rem;
		padding-block: clamp(5rem, 12vw, 10rem);
	}

	.eyebrow {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 8vw, 6.5rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.description {
		max-width: 42rem;
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.projects {
		padding-block: clamp(3rem, 8vw, 6rem);
		border-top: 1px solid var(--color-border);
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.empty-message {
		margin: 1.5rem 0 0;
		color: var(--color-muted);
		line-height: 1.6;
	}
</style>