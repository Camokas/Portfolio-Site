---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
	(firstProject, secondProject) =>
		secondProject.data.date.getTime() - firstProject.data.date.getTime(),
);

const projectCountLabel = `${projects.length} ${
	projects.length === 1 ? "project" : "projects"
}`;
---

<BaseLayout
	title="Projects | Camoka's Portfolio"
	description="Browse Camoka's creative and development projects."
	lang="en"
>
	<main class="projects-page">
		<header class="projects-header">
			<p class="eyebrow">Portfolio archive</p>

			<h1>Projects</h1>

			<p class="description">
				A growing collection of finished work, prototypes, studies, and
				experiments across every creative direction.
			</p>
		</header>

		<section class="project-catalog" aria-labelledby="catalog-title">
			<div class="catalog-heading">
				<h2 id="catalog-title">All projects</h2>

				<p>{projectCountLabel}</p>
			</div>

			{
				projects.length > 0 ? (
					<ul class="project-grid">
						{projects.map((project) => <ProjectCard project={project} />)}
					</ul>
				) : (
					<p class="empty-message">
						Published projects will appear here.
					</p>
				)
			}
		</section>
	</main>
</BaseLayout>

<style>
	.projects-page {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
	}

	.projects-header {
		display: grid;
		gap: 1.5rem;
		max-width: 58rem;
		padding-block: clamp(5rem, 12vw, 9rem);
	}

	.eyebrow {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(3rem, 9vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.description {
		max-width: 44rem;
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.project-catalog {
		padding-block: clamp(3rem, 8vw, 6rem);
		border-top: 1px solid var(--color-border);
	}

	.catalog-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
	}

	.catalog-heading h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.catalog-heading p {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
		gap: 1rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.empty-message {
		margin: 2.5rem 0 0;
		padding: 2rem;
		color: var(--color-muted);
		line-height: 1.6;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-surface);
	}

	@media (max-width: 32rem) {
		.catalog-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.75rem;
		}
	}
</style>
