---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Icon from "../../../components/ui/Icon.astro";
import SoftwarePattern from "../../../components/software/SoftwarePattern.astro";
import ProjectCard from "../../../components/projects/ProjectCard.astro";
import { software, softwareGroups, softwareLogo, type Software } from "../../../data/software";
import { getCollection, type CollectionEntry } from "astro:content";
export async function getStaticPaths() {
	const projects = await getCollection("projects", ({data}) => !data.draft && !data.demo);
	return software.map(tool => ({params:{slug:tool.slug}, props:{tool, examples:(tool.projectIds ?? []).flatMap(id => {
		const project = projects.find(item => item.id.toLowerCase() === id);
		return project ? [project] : [];
	})}}));
}
interface Props {tool:Software; examples:CollectionEntry<"projects">[];}
const {tool,examples} = Astro.props;
const base = import.meta.env.BASE_URL;
const group = softwareGroups.find(item => item.id === tool.group)!;
---
<BaseLayout title={`${tool.title} | Camoka's Portfolio`} description={tool.summary.en}>
	<main id="main-content" class="software-page" tabindex="-1">
		<a class="back-link" href={`${base}directions/software/#software-${tool.group}`}><Icon name="arrow-left" size={17} /> Back to Software I Use</a>
		<header class="software-header">
			<p class="kicker">{group.title.en}</p>
			<h1>{tool.title}</h1><p class="summary">{tool.summary.en}</p>
			<div class="metadata"><span>{tool.status}</span>{tool.firstUsed && <span><span>First used</span> · <span>{tool.firstUsed.en}</span></span>}</div>
		</header>
		<div class="project-content software-story">
			<section class="software-experience"><h2>How I use it</h2>{tool.experience.map(paragraph => <p>{paragraph.en}</p>)}
				<ul class="focus" aria-label="Tasks in my workflow">{tool.focus.map(item => <li>{item.en}</li>)}</ul>
			</section>
			<div class="software-visual" aria-hidden="true"><SoftwarePattern slugs={[tool.slug]} /><img src={softwareLogo(tool.slug,base)} width="104" height="104" alt="" /></div>
		</div>
		{examples.length > 0 && <section class="examples" aria-labelledby="examples-title"><h2 id="examples-title">Selected work using this tool</h2><ul class="project-grid">{examples.map(project => <ProjectCard project={project} />)}</ul></section>}
	</main>
</BaseLayout>
<style>
.software-page{width:min(calc(100% - 2rem),var(--content-width));margin-inline:auto;padding-block:2rem 4rem;min-width:0}
.back-link{display:inline-flex;align-items:center;gap:.5rem;color:var(--color-muted);text-decoration:none;font-size:.85rem;line-height:1.5}
.back-link:hover{text-decoration:underline;text-underline-offset:.25rem}
.back-link:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
.software-header{max-width:52rem;padding-block:clamp(2.5rem,6vw,4rem)}
.kicker{font-size:.75rem;color:var(--color-muted);margin:0 0 1rem}
h1{font-size:clamp(2.25rem,6vw,3.75rem);line-height:1.12;letter-spacing:-.045em;margin:0 0 1.2rem}
.summary{font-size:clamp(1rem,2vw,1.2rem);line-height:1.65;max-width:44rem;color:var(--color-muted);margin:0}
.metadata{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;font-size:.75rem;color:var(--color-muted);margin-top:1.5rem;line-height:1.5}
.software-story{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(2rem,5vw,4rem);align-items:center}
h2{font-size:clamp(1.35rem,3vw,1.8rem);line-height:1.3;letter-spacing:-.025em;margin:0 0 1.25rem}
.software-experience p{font-size:1rem;line-height:1.85;color:var(--color-muted);margin:0 0 1.25rem}
.software-visual{position:relative;display:grid;place-items:center;min-height:20rem;align-self:stretch;overflow:hidden;background:#131313;border-radius:1rem}
.software-visual>img{position:relative;filter:brightness(0) invert(1);opacity:.8}
.focus{display:flex;flex-wrap:wrap;gap:.5rem 1rem;list-style:none;padding:0;margin:1.5rem 0 0;font-size:.75rem;line-height:1.5}
.focus li{color:var(--color-text)}
.examples{margin-top:4rem}
.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;padding:0;margin:0}
@media(max-width:48rem){.software-story{grid-template-columns:minmax(0,1fr)}.software-visual{min-height:12rem}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:32rem){.project-grid{grid-template-columns:minmax(0,1fr)}}
</style>
