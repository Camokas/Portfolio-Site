---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import ProjectVideo from "../../components/projects/ProjectVideo.astro";
import ProjectAudio from "../../components/projects/ProjectAudio.astro";
import ProjectResources from "../../components/projects/ProjectResources.astro";
import ProjectCode from "../../components/projects/ProjectCode.astro";
import ProjectModels from "../../components/projects/ProjectModels.astro";
import RelatedProjects from "../../components/projects/RelatedProjects.astro";
import {
	getCollection,
	render,
	type CollectionEntry,
} from "astro:content";
import { directions } from "../../data/directions";
import Icon from "../../components/ui/Icon.astro";
import Gallery from "../../components/projects/inline/Gallery.astro";
import Video from "../../components/projects/inline/Video.astro";
import Audio from "../../components/projects/inline/Audio.astro";
import Models from "../../components/projects/inline/Models.astro";
import Code from "../../components/projects/inline/Code.astro";
import Resources from "../../components/projects/inline/Resources.astro";
import Downloads from "../../components/projects/inline/Downloads.astro";
import Links from "../../components/projects/inline/Links.astro";
import ShaderGraph from "../../components/projects/inline/ShaderGraph.astro";
import ProjectShaderGraphs from "../../components/projects/ProjectShaderGraphs.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const inline = project.data.mediaLayout === "inline";
const mediaComponents = { Gallery, Image: Gallery, Video, Audio, Models, Code, Resources, Downloads, Links, ShaderGraph, ShaderGraphs: ShaderGraph };
const direction = directions.find(
	(item) => item.slug === project.data.direction,
);

if (!direction) {
	throw new Error(`Unknown project direction: ${project.data.direction}`);
}

const baseUrl = import.meta.env.BASE_URL;
const directionUrl = `${baseUrl}directions/${direction.slug}/`;
const formattedDate = project.data.date.toLocaleDateString("en", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<BaseLayout
	title={`${project.data.title} | Camoka's Portfolio`}
	description={project.data.summary}
	lang="en"
	type="article"
	publishedAt={project.data.date}
	noindex={project.data.demo}
>
	<main class="project-page" id="main-content" tabindex="-1">
		<a class="back-link" href={directionUrl}>
			<Icon name="arrow-left" size={17} /> Back to {direction.title}
		</a>

		<article>
			<header class="project-header">
				<h1>{project.data.title}</h1>

				<p class="summary">{project.data.summary}</p>

				<div class="project-meta">
					<p class="eyebrow">
						<Icon name={direction.icon} size={15} /> {direction.title}
					</p>
					<time datetime={project.data.date.toISOString()}>{formattedDate}</time>

					{
						project.data.tags.length > 0 && (
							<ul aria-label="Project tags">
								{project.data.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						)
					}
					{project.data.demo && <span class="demo-label">Demo content</span>}
				</div>
			</header>

			{
				!inline && project.data.gallery.length > 0 && (
					<ProjectGallery
						items={project.data.gallery}
						projectTitle={project.data.title}
					/>
				)
			}

			{
				!inline && project.data.models.length > 0 && (
					<ProjectModels items={project.data.models} />
				)
			}

			{
				!inline && project.data.videos.length > 0 && (
					<ProjectVideo items={project.data.videos} />
				)
			}

			{
				!inline && project.data.audio.length > 0 && (
					<ProjectAudio items={project.data.audio} />
				)
			}

			{
				!inline && (project.data.downloads.length > 0 || project.data.links.length > 0) && (
					<ProjectResources
						downloads={project.data.downloads}
						links={project.data.links}
					/>
				)
			}

			{
				!inline && project.data.codeSamples.length > 0 && (
					<ProjectCode items={project.data.codeSamples} />
				)
			}

			{!inline && project.data.shaderGraphs.length > 0 && <ProjectShaderGraphs items={project.data.shaderGraphs} />}
			<div class:list={["project-content", { "is-inline": inline }]}>
				<Content components={mediaComponents} />
			</div>
		</article>
		<RelatedProjects project={project} />
	</main>
</BaseLayout>

<style>
	.project-page {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
		padding-block: clamp(2rem, 6vw, 5rem);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--color-accent);
		font-weight: 700;
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.back-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.project-header {
		display: grid;
		gap: 1.5rem;
		max-width: 50rem;
		margin-inline: auto;
		justify-items: center;
		text-align: center;
		padding-top: clamp(2rem, 5vw, 4rem);
		padding-bottom: clamp(2rem, 4vw, 2.5rem);
	}

	.project-meta,
	.project-meta ul {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.eyebrow,
	.demo-label {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.demo-label {
		padding: 0.4rem 0.6rem;
		color: var(--color-background);
		border-radius: 999px;
		background: var(--color-accent);
	}

	h1 {
		max-width: 20ch;
		margin: 0;
		font-size: clamp(2.25rem, 5.5vw, 4.5rem);
		line-height: 1.08;
		letter-spacing: -0.045em;
		overflow-wrap: anywhere;
	}

	.summary {
		max-width: 40rem;
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.project-meta {
		color: var(--color-muted);
		font-size: 0.85rem;
	}

	.project-meta ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-meta li {
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}

	.project-content {
		max-width: 70rem;
		margin-inline: auto;
		padding-block: 2rem;
		border-top: 1px solid var(--color-border);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.project-content.is-inline {
		padding-top: 0;
		border-top: 0;
		display: flow-root;
	}

	.project-content.is-inline > :global(:first-child) {
		margin-top: 0;
	}

	.project-content > :global(:not(.inline-media):not(.project-media-group)) {
		max-width: 46rem;
		margin-inline: auto;
	}

	.project-content :global(.project-media-group) {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		align-items: start;
		gap: clamp(1.5rem, 4vw, 3rem);
		margin-block: 2.5rem;
	}

	.project-content :global(.project-media-group.media-only) {
		grid-template-columns: minmax(0, 1fr);
	}

	.project-content :global(.project-group-text),
	.project-content :global(.project-group-media) { min-width: 0; }
	.project-content :global(.project-group-text > :first-child),
	.project-content :global(.project-group-media > :first-child) { margin-top: 0; }
	.project-content :global(.project-group-text > :last-child),
	.project-content :global(.project-group-media > :last-child) { margin-bottom: 0; }

	@media (max-width: 800px) {
		.project-content :global(.project-media-group) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.project-content :global(h2) {
		margin: 3rem 0 1rem;
		font-size: clamp(1.6rem, 4vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.project-content :global(p),
	.project-content :global(li) {
		color: var(--color-muted);
	}

	.project-content :global(blockquote) {
		margin: 0 0 1.5rem;
		padding: 1.25rem 1.5rem;
		color: var(--color-text);
		border-left: 0.2rem solid var(--color-accent);
		background: var(--color-surface);
	}

	.project-content :global(blockquote p) {
		margin: 0;
		color: inherit;
	}
</style>
