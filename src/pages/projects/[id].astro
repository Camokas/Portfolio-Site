---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import ProjectVideo from "../../components/projects/ProjectVideo.astro";
import ProjectAudio from "../../components/projects/ProjectAudio.astro";
import ProjectResources from "../../components/projects/ProjectResources.astro";
import ProjectCode from "../../components/projects/ProjectCode.astro";
import {
	getCollection,
	render,
	type CollectionEntry,
} from "astro:content";
import { directions } from "../../data/directions";
import Icon from "../../components/ui/Icon.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", ({ data }) => !data.draft);

	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const direction = directions.find(
	(item) => item.slug === project.data.direction,
);

if (!direction) {
	throw new Error(`Unknown project direction: ${project.data.direction}`);
}

const baseUrl = import.meta.env.BASE_URL;
const directionUrl = `${baseUrl}directions/${direction.slug}/`;
const formattedDate = project.data.date.toLocaleDateString("en", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<BaseLayout
	title={`${project.data.title} | Camoka's Portfolio`}
	description={project.data.summary}
	lang="en"
>
	<main class="project-page">
		<a class="back-link" href={directionUrl}>
			<Icon name="arrow-left" size={17} /> Back to {direction.title}
		</a>

		<article>
			<header class="project-header">
				<div class="project-labels">
					<p class="eyebrow">
						<Icon name={direction.icon} size={15} /> {direction.title}
					</p>

					{project.data.demo && <span class="demo-label">Demo content</span>}
				</div>

				<h1>{project.data.title}</h1>

				<p class="summary">{project.data.summary}</p>

				<div class="project-meta">
					<time datetime={project.data.date.toISOString()}>{formattedDate}</time>

					{
						project.data.tags.length > 0 && (
							<ul aria-label="Project tags">
								{project.data.tags.map((tag) => <li>{tag}</li>)}
							</ul>
						)
					}
				</div>
			</header>

			{
				project.data.gallery.length > 0 && (
					<ProjectGallery
						items={project.data.gallery}
						projectTitle={project.data.title}
					/>
				)
			}

			{
				project.data.videos.length > 0 && (
					<ProjectVideo items={project.data.videos} />
				)
			}

			{
				project.data.audio.length > 0 && (
					<ProjectAudio items={project.data.audio} />
				)
			}

			{
				(project.data.downloads.length > 0 || project.data.links.length > 0) && (
					<ProjectResources
						downloads={project.data.downloads}
						links={project.data.links}
					/>
				)
			}

			{
				project.data.codeSamples.length > 0 && (
					<ProjectCode items={project.data.codeSamples} />
				)
			}

			<div class="project-content">
				<Content />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	.project-page {
		width: min(calc(100% - 2rem), var(--content-width));
		margin-inline: auto;
		padding-block: clamp(2rem, 6vw, 5rem);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--color-accent);
		font-weight: 700;
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.back-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 0.25rem;
	}

	.project-header {
		display: grid;
		gap: 1.5rem;
		max-width: 58rem;
		padding-block: clamp(5rem, 12vw, 10rem);
	}

	.project-labels,
	.project-meta,
	.project-meta ul {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.eyebrow,
	.demo-label {
		margin: 0;
		color: var(--color-accent);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.demo-label {
		padding: 0.4rem 0.6rem;
		color: var(--color-background);
		border-radius: 999px;
		background: var(--color-accent);
	}

	h1 {
		max-width: 14ch;
		margin: 0;
		font-size: clamp(2.75rem, 8vw, 6.5rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.summary {
		max-width: 46rem;
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		line-height: 1.6;
	}

	.project-meta {
		color: var(--color-muted);
		font-size: 0.85rem;
	}

	.project-meta ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-meta li {
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}

	.project-content {
		max-width: 48rem;
		padding-block: clamp(3rem, 8vw, 6rem);
		border-top: 1px solid var(--color-border);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.project-content :global(h2) {
		margin: 3rem 0 1rem;
		font-size: clamp(1.6rem, 4vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.project-content :global(p),
	.project-content :global(li) {
		color: var(--color-muted);
	}

	.project-content :global(blockquote) {
		margin: 0 0 3rem;
		padding: 1.25rem 1.5rem;
		color: var(--color-text);
		border-left: 0.2rem solid var(--color-accent);
		background: var(--color-surface);
	}

	.project-content :global(blockquote p) {
		margin: 0;
		color: inherit;
	}
</style>
